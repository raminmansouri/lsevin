# Local dependencies and Next.js output must never enter the Docker build context.
node_modules
.pnpm-store
.next

# Git history is not required to compile the application.
.git
.gitignore

# Local secrets must be supplied by Docker Compose at runtime.
.env
.env.*
!.env.example

# Logs, test output, and editor files only increase context size.
*.log
coverage
artifacts
test-results
playwright-report
public-performance-baseline.json
.vscode
.idea
.DS_Store
