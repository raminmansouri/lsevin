# Local development — generated for Shop sub-system work.
# Points the webapp at the docker-compose.dev.yml infra (deployments/docker/).
# This file is gitignored (.env*). Do not use these values anywhere but localhost.

NODE_ENV=development

# --- Database (postgres from docker-compose.dev.yml, published on localhost) ---
DATABASE_URL=postgres://lsevin:lsevin@localhost:5432/lsevin
DATABASE_URL_DIRECT=postgres://lsevin:lsevin@localhost:5432/lsevin
POSTGRES_PREPARE=true
POSTGRES_DEBUG=false

# --- Auth / server actions ---
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=dev-only-server-actions-key-0123456789abcdef
WEBHOOK_KEY=dev-only-webhook-key
WEBAPP_API_KEY=dev-only-webapp-api-key

# --- API (run src/API/LSevin.Api natively: dotnet run --project src/API/LSevin.Api) ---
INTERNAL_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_FILES_URL=http://localhost:9000/lsevin-media
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080/hubs
NEXT_PUBLIC_LSEVIN_COOKIE_DOMAIN=

# --- App base URL for payment gateway callbacks (Shop + booking) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Media storage (MinIO from docker-compose.dev.yml) ---
FILE_STORAGE_BACKEND=Minio
S3_SERVICE_URL=http://localhost:9000
S3_BUCKET=lsevin-media
S3_ACCESS_KEY=lsevin-dev-media
S3_SECRET_KEY=lsevin-dev-media-secret

# Maps (optional in dev; blank disables the map widgets)
NEXT_PUBLIC_NESHAN_MAP_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
