@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

class __EFMigrationsHistory {
   product_version: varchar(32)
   migration_id: varchar(150)
}
class consulting_selected_document_references {
   customer_document_id: uuid
   consulting_id: uuid
}
class consultings {
   customer_id: uuid
   description: varchar(2000)
   create_date: timestamp with time zone
   last_modified_date: timestamp with time zone
   category_id: uuid
   category_name: varchar(250)
   id: uuid
}
class customer_document_types {
   name: varchar(25)
   id: integer
}
class customer_documents {
   document_type_id: integer
   document_url: varchar(250)
   customer_id: uuid
   create_date: timestamp with time zone
   last_modified_date: timestamp with time zone
   id: uuid
}
class customers {
   phone_number: varchar(15)
   phone_number_country_code: varchar(3)
   email: varchar(250)
   birth_date: timestamp with time zone
   street_translations: jsonb
   city: varchar(15)
   country: varchar(15)
   detail_translations: jsonb
   zip_code: varchar(50)
   first_name: varchar(100)
   last_name: varchar(50)
   create_date: timestamp with time zone
   last_modified_date: timestamp with time zone
   gender: varchar(25)
   is_active: boolean
   id: uuid
}
class inbox_message_consumers {
   message_id: uuid
   name: varchar(500)
}
class inbox_messages {
   type: varchar(250)
   content: jsonb
   occurred_on_utc: timestamp with time zone
   processed_on_utc: timestamp with time zone
   error: text
   id: uuid
}
class internal_command_message_consumers {
   message_id: uuid
   name: varchar(500)
}
class internal_command_messages {
   type: varchar(250)
   content: jsonb
   occurred_on_utc: timestamp with time zone
   processed_on_utc: timestamp with time zone
   error: text
   id: uuid
}
class outbox_message_consumers {
   message_id: uuid
   name: varchar(500)
}
class outbox_messages {
   type: varchar(250)
   content: jsonb
   occurred_on_utc: timestamp with time zone
   processed_on_utc: timestamp with time zone
   error: text
   id: uuid
}

consulting_selected_document_references  -[#595959,plain]-^  consultings                             : "consulting_id:id"
consulting_selected_document_references  -[#595959,plain]-^  customer_documents                      : "customer_document_id:id"
consultings                              -[#595959,plain]-^  customers                               : "customer_id:id"
customer_documents                       -[#595959,plain]-^  customer_document_types                 : "document_type_id:id"
customer_documents                       -[#595959,plain]-^  customers                               : "customer_id:id"
@enduml
