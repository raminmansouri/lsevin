{
    "Services": {
        "lsevin-api": {
            "http": "http://localhost:5003",
            "https": "https://localhost:5002"
        }
    },
    "SerilogOptions": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "SeqUrl": "http://localhost:5341"
    },
    "ReverseProxy": {
        "Routes": {
            "lsevin-route": {
                "ClusterId": "lsevin-cluster",
                "Match": {
                    "Path": "{**catch-all}"
                },
                "RateLimiterPolicy": "fixed-window",
                "Transforms": [
                    {
                        "PathPattern": "{**catch-all}"
                    },
                    {
                        "RequestHeadersCopy": "true"
                    },
                    {
                        "RequestHeaderOriginalHost": "true"
                    },
                    {
                        "X-Forwarded": "Set",
                        "For": "Remove",
                        "Proto": "Append",
                        "Prefix": "Off",
                        "HeaderPrefix": "X-Forwarded-"
                    },
                    {
                        "Forwarded": "by,for,host,proto",
                        "ByFormat": "Random",
                        "ForFormat": "IpAndPort",
                        "Action": "Append"
                    },
                    {
                        "ResponseHeadersCopy": "true"
                    }
                ]
            }
        },
        "Clusters": {
            "lsevin-cluster": {
                "loadBalancingPolicy": "RoundRobin",
                "Destinations": {
                    "destination1": {
                        "Address": "https+http://lsevin-api"
                    }
                }
            }
        }
    },
    "ObservabilityOptions": {
        "InstrumentationName": "lsevin-api",
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:14317",
            "HttpExporterEndpoint": "http://localhost:14268/api/traces"
        },
        "UseAspireOTLPExporter": true,
        "ServiceName": "LSevin API"
    },
    "RateLimitOptions": {
        "Limit": 5,
        "PeriodInMs": 1000,
        "QueueLimit": 0
    },
    "JwtOptions": {
        "Issuer": "https+http://lsevin-api",
        "SecretKey": "HJ87Mb69XFe5qA2dJJ6TsBUSUNGpyqd7KnJQ/FxeRro=",
        "Audience": "lsevin-api",
        "TokenLifeTimeSecond": 300,
        "CheckRevokedAccessTokens": true
    },
    "AllowedHosts": "*"
}
