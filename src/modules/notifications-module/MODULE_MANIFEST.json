    "en-US",
    "ar",
    "tr-TR"
  ],
  "zipSafe": true,
  "migrations": [
    "migrations/001_notifications_module.sql",
    "migrations/002_notifications_bridge.sql",
    "migrations/031_reviews_workflow_templates.sql",
    "migrations/032_booking_lifecycle_templates.sql"
  ]
}
