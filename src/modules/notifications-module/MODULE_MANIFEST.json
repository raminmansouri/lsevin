{
  "code": "notifications-module",
  "name": "Notifications",
  "version": "1.0.1",
  "type": "extended",
  "dependsOn": [
    "core"
  ],
  "databaseSchema": "notifications_ext",
  "folder": "src/modules/notifications-module",
