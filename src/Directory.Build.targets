<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Target Name="DisableAppleSdks" BeforeTargets="PrepareForBuild">
		<PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
			<UseMaui>false</UseMaui>
			<EnableIos>false</EnableIos>
			<EnableMacCatalyst>false</EnableMacCatalyst>
			<EnableTvOS>false</EnableTvOS>
			<EnableWatchOS>false</EnableWatchOS>
		</PropertyGroup>
	</Target>
  <ItemGroup>
    <None Include="**\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
  </ItemGroup>
</Project>
