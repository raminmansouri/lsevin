pipeline {
  agent {
    node {
      // Required by Declarative Pipeline's `node` agent type. This is a
      // single-controller Jenkins with no separate registered agents (see
      // casc/jenkins.yaml: numExecutors: 1, no nodes: block), so the
      // built-in node — reserved automatically, always present — is the
      // only valid target.
      label 'built-in'
      customWorkspace '/opt/lsevin-platform'
    }
  }

  options {
    // Jenkins performs the checkout explicitly into /opt/lsevin-platform.
    skipDefaultCheckout(true)

    // A second commit waits until the current production deployment finishes.
    disableConcurrentBuilds()

    timestamps()
    timeout(time: 60, unit: 'MINUTES')
  }

  environment {
    // Dedicated checkout directory on the VPS.
    SOURCE_DIR = '/opt/lsevin-platform'

    // The Compose file that already defines API, webapp, PostgreSQL, Redis,
    // EventStore, and Caddy.
    COMPOSE_FILE = '/opt/lsevin-platform/deployments/docker/docker-compose.server.yml'

    // Same production secrets Strategy A (root Jenkinsfile/deploy-local.sh)
    // already maintains at this path -- not a separate file. This path is a
    // completely different top-level directory from /opt/lsevin-platform
    // (this pipeline's own workspace), so it was never at risk from stage 1's
    // deleteDir() to begin with; deploy-local.sh's rsync also excludes it
    // from ever being overwritten by a checkout. One shared file for both
    // pipelines avoids the two ever drifting out of sync with each other.
    ENV_FILE = '/opt/lsevin/app/deployments/docker/.env'

    // Keep the existing Compose project name so Jenkins manages the current
    // docker-lsevin-api-1 and docker-lsevin-webapp-1 containers.
    COMPOSE_PROJECT_NAME = 'docker'

    // /readiness (not /hc -- that route only exists when ASPNETCORE_ENVIRONMENT
    // is Development; see BuildingBlocks.Web/Extensions/HealthCheckExtensions.cs
    // and WebConstants.cs. Polling /hc here 404s every single time in
    // production, no matter how long you wait.
    API_HEALTH_URL = 'https://api.lsevin.com/readiness'
    WEBAPP_HEALTH_URL = 'https://appmain.lsevin.com/'
  }

  stages {
    stage('1. Checkout') {
      steps {
        // /opt/lsevin-platform is dedicated to this repository, so cleaning it is
        // safe and prevents deleted Git files from remaining on the server.
        deleteDir()
        checkout scm
      }
    }

    stage('2. Prepare release') {
      steps {
        script {
          env.RELEASE_TAG = sh(
            script: "git -C '${env.SOURCE_DIR}' rev-parse --short=12 HEAD",
            returnStdout: true
          ).trim()
        }

        sh '''
          set -eu

          if [ ! -f "$ENV_FILE" ]; then
            echo "Missing $ENV_FILE" >&2
            echo "" >&2
            echo "This is the same production .env that Strategy A (root Jenkinsfile /" >&2
            echo "deploy-local.sh) already maintains -- if it's missing, this server was" >&2
            echo "never bootstrapped yet. Follow deployments/FIRST-RUN.md section 5" >&2
            echo "(\"Create the production .env\") once, then re-run this job." >&2
            exit 1
          fi
          test -f "$COMPOSE_FILE"

          # Validate all environment substitutions and Compose syntax before any
          # image is built or production container is changed.
          docker compose \
            --project-name "$COMPOSE_PROJECT_NAME" \
            --env-file "$ENV_FILE" \
            --file "$COMPOSE_FILE" \
            config --quiet
        '''
      }
    }

    stage('3. Save rollback images') {
      steps {
        script {
          // Tag the exact images used by the currently running containers.
          // These tags make rollback independent of mutable image names.
          env.OLD_API_TAG = "rollback-${env.BUILD_NUMBER}"
          env.OLD_WEBAPP_TAG = "rollback-${env.BUILD_NUMBER}"
        }

        sh '''
          set -eu

          api_container="$(docker compose \
            --project-name "$COMPOSE_PROJECT_NAME" \
            --env-file "$ENV_FILE" \
            --file "$COMPOSE_FILE" \
            ps --quiet lsevin-api 2>/dev/null || true)"

          webapp_container="$(docker compose \
            --project-name "$COMPOSE_PROJECT_NAME" \
            --env-file "$ENV_FILE" \
            --file "$COMPOSE_FILE" \
            ps --quiet lsevin-webapp 2>/dev/null || true)"

          if [ -n "$api_container" ]; then
            api_image_id="$(docker inspect --format '{{.Image}}' "$api_container")"
            # A running container outlives its image entry being pruned from the
            # local image list (docker image prune, or deploy-local.sh's own
            # cleanup) -- it keeps running fine, but "docker image tag" on that
            # now-delisted id fails with "No such image" even though the
            # container plainly still exists. Fall back to snapshotting the live
            # container directly (matching deploy-local.sh's save_rollback_image),
            # so rollback safety survives that case instead of silently
            # vanishing for this one deploy.
            if ! docker image tag "$api_image_id" "lsevin-api:$OLD_API_TAG" 2>/dev/null; then
              echo "lsevin-api's running image ($api_image_id) is no longer in the local image list (likely pruned) -- committing a live snapshot instead." >&2
              docker commit --pause=true "$api_container" "lsevin-api:$OLD_API_TAG"
            fi
          else
            OLD_API_TAG=""
          fi

          if [ -n "$webapp_container" ]; then
            webapp_image_id="$(docker inspect --format '{{.Image}}' "$webapp_container")"
            if ! docker image tag "$webapp_image_id" "lsevin-webapp:$OLD_WEBAPP_TAG" 2>/dev/null; then
              echo "lsevin-webapp's running image ($webapp_image_id) is no longer in the local image list (likely pruned) -- committing a live snapshot instead." >&2
              docker commit --pause=true "$webapp_container" "lsevin-webapp:$OLD_WEBAPP_TAG"
            fi
          else
            OLD_WEBAPP_TAG=""
          fi

          printf '%s' "$OLD_API_TAG" > "$SOURCE_DIR/.jenkins-old-api-tag"
          printf '%s' "$OLD_WEBAPP_TAG" > "$SOURCE_DIR/.jenkins-old-webapp-tag"
        '''
      }
    }

    stage('4. Build API and webapp') {
      steps {
        dir(env.SOURCE_DIR) {
          sh '''
            set -eu

            # Do not add --pull or --no-cache here. The host Docker daemon keeps
            # dependency and compiler layers between Jenkins builds.
            DOCKER_BUILDKIT=1 \
            LSEVIN_API_IMAGE_TAG="$RELEASE_TAG" \
            LSEVIN_WEBAPP_IMAGE_TAG="$RELEASE_TAG" \
            docker compose \
              --project-name "$COMPOSE_PROJECT_NAME" \
              --env-file "$ENV_FILE" \
              --file "$COMPOSE_FILE" \
              build lsevin-api lsevin-webapp
          '''
        }
      }
    }

    /*
     * Migrations run before any container is replaced, so a failure here leaves the
     * release that is currently serving untouched.
     *
     * Why this stage exists: nothing applied them. deploy-local.sh scans
     * scripts/sql/*.sql, a directory this repository does not contain, and this
     * pipeline had no migration step at all -- so code depending on a new column
     * shipped against a database without it, and every page using that column
     * returned 500 until someone ran the runner by hand.
     *
     * It cannot call `pnpm migrate`: the webapp image is a Next standalone build
     * holding only public/, package.json, .next/standalone and .next/static, so
     * neither db/migrations nor scripts/migrate.mjs survive into it. This instead
     * reproduces what that runner does, against the source Jenkins already checked
     * out, writing the same public.schema_migrations registry so that
     * `pnpm migrate:status` keeps telling the truth:
     *   - apply files in filename order, once each
     *   - stop if a file that was already applied has since been edited
     *   - record name, checksum and duration after each success
     */
    stage('5. Apply database migrations') {
      steps {
        dir(env.SOURCE_DIR) {
          sh '''
            set -eu

            MIGRATION_DIR="$SOURCE_DIR/frontend/webapp/db/migrations"

            if ! ls "$MIGRATION_DIR"/*.sql >/dev/null 2>&1; then
              echo "No migrations found in $MIGRATION_DIR; nothing to apply."
              exit 0
            fi

            pg_container="$(docker compose \
              --project-name "$COMPOSE_PROJECT_NAME" \
              --env-file "$ENV_FILE" \
              --file "$COMPOSE_FILE" \
              ps -q postgres)"

            [ -n "$pg_container" ] || { echo "Postgres container is not running." >&2; exit 1; }

            run_sql() {
              docker exec -i "$pg_container" sh -lc \
                'psql -qtAX -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
            }

            printf '%s' "create table if not exists public.schema_migrations (
                      name text primary key,
                      checksum text not null,
                      applied_at timestamptz not null default now(),
                      duration_ms integer not null
                    );" | run_sql >/dev/null

            for migration in "$MIGRATION_DIR"/*.sql; do
              name="$(basename "$migration")"
              checksum="$(sha256sum "$migration" | cut -d' ' -f1)"

              recorded="$(printf "select checksum from public.schema_migrations where name = '%s';" \
                "$name" | run_sql)"

              if [ -n "$recorded" ]; then
                if [ "$recorded" != "$checksum" ]; then
                  echo "ERROR: $name was already applied but its contents changed." >&2
                  echo "Write a new migration instead of editing an applied one." >&2
                  exit 1
                fi
                echo "already applied: $name"
                continue
              fi

              echo "applying: $name"
              started="$(date +%s)"
              docker exec -i "$pg_container" sh -lc \
                'psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' < "$migration"
              duration="$(( ($(date +%s) - started) * 1000 ))"

              printf "insert into public.schema_migrations (name, checksum, duration_ms) values ('%s', '%s', %s);" \
                "$name" "$checksum" "$duration" | run_sql >/dev/null

              echo "applied: $name"
            done
          '''
        }
      }
    }

    stage('6. Deploy API') {
      steps {
        sh '''
          set -eu

          old_webapp_tag="$(cat "$SOURCE_DIR/.jenkins-old-webapp-tag")"
          [ -n "$old_webapp_tag" ] || old_webapp_tag="$RELEASE_TAG"

          # Provision the media bucket, its anonymous-read policy and the scoped API
          # service account before the API starts. Idempotent -- a no-op once done.
          # --no-deps: minio already runs (restart: unless-stopped); don't touch
          # Postgres/EventStore/etc. A non-zero exit here fails the deploy, which is
          # what we want -- the API's MinioStartupCheck would abort anyway.
          docker compose \
            --project-name "$COMPOSE_PROJECT_NAME" \
            --env-file "$ENV_FILE" \
            --file "$COMPOSE_FILE" \
            run --rm -T --no-deps minio-init

          LSEVIN_API_IMAGE_TAG="$RELEASE_TAG" \
          LSEVIN_WEBAPP_IMAGE_TAG="$old_webapp_tag" \
          docker compose \
            --project-name "$COMPOSE_PROJECT_NAME" \
            --env-file "$ENV_FILE" \
            --file "$COMPOSE_FILE" \
            up --detach --no-deps lsevin-api

          attempt=1
          until curl --fail --silent --show-error --max-time 10 "$API_HEALTH_URL" >/dev/null; do
            if [ "$attempt" -ge 30 ]; then
              echo "API did not become healthy after 30 attempts" >&2
              exit 1
            fi
            attempt=$((attempt + 1))
            sleep 2
          done
        '''
      }
    }

    stage('7. Deploy webapp') {
      steps {
        sh '''
          set -eu

          LSEVIN_API_IMAGE_TAG="$RELEASE_TAG" \
          LSEVIN_WEBAPP_IMAGE_TAG="$RELEASE_TAG" \
          docker compose \
            --project-name "$COMPOSE_PROJECT_NAME" \
            --env-file "$ENV_FILE" \
            --file "$COMPOSE_FILE" \
            up --detach --no-deps lsevin-webapp

          attempt=1
          until curl --fail --silent --show-error --location --max-time 15 "$WEBAPP_HEALTH_URL" >/dev/null; do
            if [ "$attempt" -ge 30 ]; then
              echo "Webapp did not become healthy after 30 attempts" >&2
              exit 1
            fi
            attempt=$((attempt + 1))
            sleep 2
          done
        '''
      }
    }

    stage('8. Mark stable release') {
      steps {
        sh '''
          set -eu
          docker image tag "lsevin-api:$RELEASE_TAG" lsevin-api:stable
          docker image tag "lsevin-webapp:$RELEASE_TAG" lsevin-webapp:stable
        '''
      }
    }
  }

  post {
    failure {
      sh '''
        set +e

        old_api_tag="$(cat "$SOURCE_DIR/.jenkins-old-api-tag" 2>/dev/null)"
        old_webapp_tag="$(cat "$SOURCE_DIR/.jenkins-old-webapp-tag" 2>/dev/null)"

        if [ -n "$old_api_tag" ] && [ -n "$old_webapp_tag" ]; then
          echo "Deployment failed; restoring the previous API and webapp images."

          LSEVIN_API_IMAGE_TAG="$old_api_tag" \
          LSEVIN_WEBAPP_IMAGE_TAG="$old_webapp_tag" \
          docker compose \
            --project-name "$COMPOSE_PROJECT_NAME" \
            --env-file "$ENV_FILE" \
            --file "$COMPOSE_FILE" \
            up --detach --no-deps lsevin-api lsevin-webapp
        else
          echo "No previous images were available for automatic rollback."
        fi

        # Cleanup happens here, in the same block, deliberately -- NOT in a
        # separate `always` block. Jenkins runs post-condition blocks in a
        # fixed order (always, ..., aborted, failure, success, ...)
        # regardless of the order they're written in this file, so an
        # `always` block unconditionally runs BEFORE `failure` every time.
        # A prior version of this file deleted these two files in `always`,
        # which silently deleted them before this block ever got to read
        # them above -- old_api_tag/old_webapp_tag were empty on every
        # single failure, so automatic rollback never actually triggered.
        rm -f \
          "$SOURCE_DIR/.jenkins-old-api-tag" \
          "$SOURCE_DIR/.jenkins-old-webapp-tag"
      '''
    }

    success {
      sh '''
        rm -f \
          "$SOURCE_DIR/.jenkins-old-api-tag" \
          "$SOURCE_DIR/.jenkins-old-webapp-tag"
      '''
    }
  }
}
