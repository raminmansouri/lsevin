pipeline {
  agent { node { label 'built-in'; customWorkspace '/opt/lsevin-platform' } }
  options { skipDefaultCheckout(true); disableConcurrentBuilds(); timestamps(); timeout(time: 60, unit: 'MINUTES') }
  environment {
    NAMESPACE = 'lsevin'
    ENV_FILE = '/opt/lsevin/app/deployments/docker/.env'
    DEPLOY = '/opt/lsevin/app/deployments/jenkins/k3s-deploy.sh'
  }
  stages {
    stage('Checkout') { steps { deleteDir(); checkout scm } }
    stage('Prepare') {
      steps {
        script { env.IMAGE_TAG = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim() }
        sh 'test -r "$ENV_FILE"; chmod +x "$DEPLOY"; "$DEPLOY" kubectl get node'
      }
    }
    stage('Build') {
      steps {
        sh '''set -eu
          set -a; . "$ENV_FILE"; set +a
          docker build -f src/API/LSevin.Api/Dockerfile -t "lsevin-api:$IMAGE_TAG" .
          DOCKER_BUILDKIT=1 docker build -f frontend/webapp/Dockerfile \
            --build-arg NEXT_PUBLIC_URL --build-arg NEXT_PUBLIC_API_URL \
            --build-arg NEXT_PUBLIC_FILES_URL --build-arg NEXT_PUBLIC_SOCKET_URL \
            --build-arg NEXT_PUBLIC_MAPBOX_TOKEN --build-arg NEXT_PUBLIC_NESHAN_MAP_KEY \
            --build-arg NEXT_PUBLIC_CRM_ANALYTICS_URL --build-arg NEXT_PUBLIC_CRM_ANALYTICS_SITE_KEY \
            --secret id=database_url,env=DATABASE_URL --secret id=auth_secret,env=AUTH_SECRET \
            --secret id=webhook_key,env=WEBHOOK_KEY \
            -t "lsevin-webapp:$IMAGE_TAG" frontend/webapp
          docker build -f frontend/webapp/Dockerfile.migrations \
            -t "lsevin-webapp-migrations:$IMAGE_TAG" frontend/webapp
          "$DEPLOY" import "core-$IMAGE_TAG.tar" \
            "lsevin-api:$IMAGE_TAG" "lsevin-webapp:$IMAGE_TAG" "lsevin-webapp-migrations:$IMAGE_TAG"
        '''
      }
    }
    stage('Deploy API') {
      steps {
        sh '''set -eu
          "$DEPLOY" kubectl -n "$NAMESPACE" set image deployment/lsevin-api api="lsevin-api:$IMAGE_TAG"
          "$DEPLOY" kubectl -n "$NAMESPACE" rollout status deployment/lsevin-api --timeout=10m
        '''
      }
    }
    stage('Deploy webapp') {
      steps {
        sh '''set -eu
          "$DEPLOY" kubectl -n "$NAMESPACE" set image deployment/lsevin-webapp web="lsevin-webapp:$IMAGE_TAG"
          if "$DEPLOY" kubectl -n "$NAMESPACE" get deployment/lsevin-webapp \
              -o jsonpath='{.spec.template.spec.initContainers[*].name}' | grep -qw migrate; then
            "$DEPLOY" kubectl -n "$NAMESPACE" set image deployment/lsevin-webapp \
              migrate="lsevin-webapp-migrations:$IMAGE_TAG"
          fi
          "$DEPLOY" kubectl -n "$NAMESPACE" rollout status deployment/lsevin-webapp --timeout=10m
        '''
      }
    }
  }
  post {
    failure {
      sh '''"$DEPLOY" kubectl -n "$NAMESPACE" rollout undo deployment/lsevin-api || true
        "$DEPLOY" kubectl -n "$NAMESPACE" rollout undo deployment/lsevin-webapp || true'''
    }
  }
}
