# Copy this file to /etc/lsevin/projects/providers.env on the server.
# Protect it with: chmod 600 /etc/lsevin/projects/providers.env

# Public values compiled into Next.js browser code during the image build.
NEXT_PUBLIC_URL=https://providers.lsevin.com
NEXT_PUBLIC_API_URL=https://api.lsevin.com/api/v1
NEXT_PUBLIC_FILES_URL=https://api.lsevin.com/files

# postgres.js reads this connection string at runtime and during migrations.
DATABASE_URL=postgres://providers_user:CHANGE_ME@postgres:5432/lsevin_providers

# Use the exact package.json script provided by this repository.
# Allowed examples: migrate or migrate:all
MIGRATION_SCRIPT=migrate:all

# Auth.js / NextAuth values.
AUTH_URL=https://providers.lsevin.com
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
AUTH_TRUST_HOST=true

# Add other private runtime settings required by this application below.
