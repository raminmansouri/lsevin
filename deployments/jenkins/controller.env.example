# Persistent Jenkins data and administrator settings.
JENKINS_HOME_DIR=/var/lib/lsevin/jenkins
JENKINS_SECRET_DIR=/etc/lsevin/jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_EMAIL=admin@lsevin.com
JENKINS_DOMAIN=devops.lsevin.com
LSEVIN_DOCKER_NETWORK=lsevin-network

# Jenkins credential ID containing the GitHub username/token.
JENKINS_GITHUB_CREDENTIALS_ID=github-pat


# Main LSevin monorepo containing lsevin-api and lsevin-webapp.
JENKINS_MAIN_REPOSITORY_URL=https://github.com/raminmansouri/lsevin.git
JENKINS_MAIN_BRANCH=Lsevin-New

# CRM repository and branch.
JENKINS_CRM_REPOSITORY_URL=https://github.com/Mohammadjafariyan/CRM_New.git
JENKINS_CRM_BRANCH=main

# Providers repository and branch.
JENKINS_PROVIDERS_REPOSITORY_URL=https://github.com/Mohammadjafariyan/lsevin-portal.git
JENKINS_PROVIDERS_BRANCH=main

# Shop repository and branch.
JENKINS_SHOP_REPOSITORY_URL=https://github.com/Mohammadjafariyan/lsevin-shop.git
JENKINS_SHOP_BRANCH=main
