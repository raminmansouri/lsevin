#!/usr/bin/env bash
# lsevin-webapp-cache-recycle - runs ON SERVER B from lsevin-webapp-cache-recycle.timer (every 20 min).
# Why: the Next.js webapp writes its ISR page cache (.html/.rsc/.meta under /app/.next/server/app/<locale>/...) into the container's own writable
# layer, unbounded (next.config cacheMaxMemorySize=0): ~1.1 GB/hour per pod. Left alone it filled B's disk to 94.5% on 2026-11-16/17, the kubelet
# evicted pods (including Postgres) and deleted its now-unused image. A pod restart empties the cache, so the pods are recycled BEFORE they get big.
# How: `kubectl rollout restart` of the Deployment (RollingUpdate maxSurge 1 / maxUnavailable 0 + readiness probe = one pod always serves).
# Triggers: the biggest webapp writable layer >= LAYER_MB (default 5000), or root disk >= DISK_PCT (default 85) with any pod layer >= 1000 MB.
# Skipped while: a build/deploy is running, the Deployment is not fully ready/updated, or the last recycle was < MIN_INTERVAL_MIN minutes ago.
# Proper fix is in the app (bounded ISR cache: isrFlushToDisk=false + cacheMaxMemorySize, or a cache handler); this keeps the node safe meanwhile.
#   lsevin-webapp-cache-recycle --dry-run   decide and log, restart nothing
set -uo pipefail
LAYER_MB=${LAYER_MB:-5000}; DISK_PCT=${DISK_PCT:-85}; MIN_INTERVAL_MIN=${MIN_INTERVAL_MIN:-45}; NS=${NS:-lsevin}; DEPLOY=${DEPLOY:-lsevin-webapp}
LOG=${LOG:-/var/log/lsevin-webapp-cache-recycle.log}; STATE=${STATE:-/var/lib/lsevin/webapp-cache-recycle.last}
DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1
K="k3s kubectl -n $NS"; CRI="k3s crictl"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }
mkdir -p "$(dirname "$STATE")"
exec 9>/run/lock/lsevin-webapp-cache-recycle.lock; flock -n 9 || { echo "another run in progress" >&2; exit 0; }

ps -eo args | grep -qE "[d]ocker build|[k]3s-deploy.sh (import|deploy)" && { log "skip: a build/deploy is running"; exit 0; }
read -r want ready updated avail <<<"$($K get deploy "$DEPLOY" -o jsonpath='{.spec.replicas} {.status.readyReplicas} {.status.updatedReplicas} {.status.availableReplicas}' 2>/dev/null)"
want=${want:-0}; ready=${ready:-0}; updated=${updated:-0}; avail=${avail:-0}
if [ "$want" -lt 2 ] || [ "$ready" -ne "$want" ] || [ "$updated" -ne "$want" ] || [ "$avail" -ne "$want" ]; then
  log "skip: deployment not stable (want=$want ready=$ready updated=$updated available=$avail)"; exit 0
fi

# biggest writable layer of a running webapp "web" container, in MB
max_mb=$($CRI stats -o json 2>/dev/null | python3 -c "
import sys,json
try: d=json.load(sys.stdin)
except Exception: print(-1); sys.exit()
m=0
for s in d.get('stats',[]):
    a=s['attributes']
    if a['labels'].get('io.kubernetes.pod.name','').startswith('$DEPLOY-') and a['metadata']['name']=='web':
        m=max(m,int(s.get('writableLayer',{}).get('usedBytes',{}).get('value',0))//1048576)
print(m)")
disk=$(df --output=pcent / | tail -1 | tr -dc 0-9)
[ "${max_mb:--1}" -ge 0 ] 2>/dev/null || { log "skip: could not read container stats"; exit 0; }

reason=""
[ "$max_mb" -ge "$LAYER_MB" ] && reason="largest pod cache ${max_mb} MB >= ${LAYER_MB} MB"
[ -z "$reason" ] && [ "$disk" -ge "$DISK_PCT" ] && [ "$max_mb" -ge 1000 ] && reason="disk ${disk}% >= ${DISK_PCT}% and pod cache ${max_mb} MB"
[ -n "$reason" ] || { echo "$(date -u +%FT%TZ) ok: largest pod cache ${max_mb} MB, disk ${disk}%" >> "$LOG"; exit 0; }

now=$(date +%s); last=$(cat "$STATE" 2>/dev/null || echo 0)
min_gap=$((MIN_INTERVAL_MIN * 60)); [ "$disk" -ge "$DISK_PCT" ] && min_gap=1200
if [ $((now - last)) -lt "$min_gap" ]; then log "skip: $reason, but the last recycle was $(( (now - last) / 60 )) min ago (min gap $((min_gap / 60)) min)"; exit 0; fi

if [ "$DRY" = 1 ]; then log "DRY RUN: would roll-restart $DEPLOY ($reason)"; exit 0; fi
log "recycling $DEPLOY: $reason"
echo "$now" > "$STATE"
$K rollout restart "deployment/$DEPLOY" >>"$LOG" 2>&1 || { log "rollout restart FAILED"; exit 1; }
if $K rollout status "deployment/$DEPLOY" --timeout=600s >>"$LOG" 2>&1; then
  log "done: disk $(df --output=pcent / | tail -1 | tr -dc 0-9)%"
else
  log "ERROR: rollout did not finish within 10 min - check the pods (the old pod keeps serving: maxUnavailable=0)"; exit 1
fi
