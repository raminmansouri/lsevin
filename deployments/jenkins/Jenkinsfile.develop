pipeline {
  agent { node { label 'built-in'; customWorkspace '/opt/lsevin-platform-development' } }
  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds(abortPrevious: true)
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
  }
  environment {
    ENV_FILE = '/opt/lsevin/app/deployments/docker/.env'
    DOCKER_BUILD_LIMITS = '--resource cpu-quota=100000 --resource memory=2560m'
    WEB_BUILD_MODE = 'fast'
    WEB_PUBLIC_URL = 'https://dev.lsevin.com'
  }
  stages {
    stage('Checkout develop') { steps { deleteDir(); checkout scm } }
    stage('Source integrity') {
      steps { sh '''set -eu
        test "$(git branch --show-current)" = develop || { echo 'Development job must build the develop branch.' >&2; exit 1; }
        if git grep -n -E '^(<<<<<<<|=======|>>>>>>>)' -- . ':!*.md'; then
          echo 'Unresolved Git conflict markers found.' >&2
          exit 1
        fi
      ''' }
    }
    stage('Fast web build') {
      steps { sh '''set -eu
        set +x
        set -a; . "$ENV_FILE"; set +a
        NEXT_PUBLIC_URL="$WEB_PUBLIC_URL"
        tag="$(git rev-parse --short=12 HEAD)-dev-${BUILD_NUMBER}"
        DOCKER_BUILDKIT=1 docker build $DOCKER_BUILD_LIMITS -f frontend/webapp/Dockerfile \
          --build-arg BUILD_MODE="$WEB_BUILD_MODE" \
          --build-arg NEXT_PUBLIC_URL --build-arg NEXT_PUBLIC_API_URL \
          --build-arg NEXT_PUBLIC_FILES_URL --build-arg NEXT_PUBLIC_SOCKET_URL \
          --build-arg NEXT_PUBLIC_MAPBOX_TOKEN --build-arg NEXT_PUBLIC_NESHAN_MAP_KEY \
          --build-arg NEXT_PUBLIC_CRM_ANALYTICS_URL --build-arg NEXT_PUBLIC_CRM_ANALYTICS_SITE_KEY \
          --secret id=database_url,env=DATABASE_URL --secret id=auth_secret,env=AUTH_SECRET \
          --secret id=webhook_key,env=WEBHOOK_KEY \
          -t "lsevin-webapp-development:$tag" frontend/webapp
        docker image inspect "lsevin-webapp-development:$tag" >/dev/null
        docker image rm "lsevin-webapp-development:$tag" >/dev/null
      ''' }
    }
  }
}
