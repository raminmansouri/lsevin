# /etc/lsevin-alerter/telegram.env on server B (mode 600). Create the bot with @BotFather, send it any message, then
# open https://api.telegram.org/bot<TOKEN>/getUpdates to read "chat":{"id":...}. A group chat id is negative.
TELEGRAM_BOT_TOKEN=
# Private chat(s) for everything that is NOT critical (warnings, info, daily summary), comma separated.
TELEGRAM_CHAT_ID=
# The channel for CRITICAL messages only (new / still open / resolved criticals, MONITORING BROKEN). Channel ids look like -100xxxxxxxxxx and the
# bot must be an administrator of the channel. If this line is empty/missing, every message goes to every chat in TELEGRAM_CHAT_ID (old behaviour).
TELEGRAM_CRITICAL_CHAT_ID=
