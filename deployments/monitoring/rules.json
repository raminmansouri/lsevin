{
  "prometheus": "",
  "eval_seconds": 60,
  "daily_summary_utc": "07:00",
  "http_checks": [
    {
      "name": "global app (lsevincare.com)",
      "url": "https://lsevincare.com/api/health",
      "expect": [
        200
      ],
      "for": 120,
      "severity": "critical",
      "cert_days_min": 14
    },
    {
      "name": "global app alias (appmain)",
      "url": "https://appmain.lsevin.com/api/health",
      "expect": [
        200
      ],
      "for": 120,
      "severity": "critical",
      "cert_days_min": 14
    },
    {
      "name": "mobile app probe (lsevincare.com)",
      "url": "https://lsevincare.com/app-health",
      "expect": [
        204
      ],
      "for": 180,
      "severity": "warning"
    },
    {
      "name": "API readiness (api.lsevin.com)",
      "url": "https://api.lsevin.com/readiness",
      "expect": [
        200
      ],
      "for": 120,
      "severity": "critical",
      "cert_days_min": 14
    },
    {
      "name": "media file via lsevincare.com",
      "url": "https://lsevincare.com/files/Categories/services/019e0f1a-cd9b-da39-b05d-a071f0deda06.jpg",
      "expect": [
        200
      ],
      "for": 120,
      "severity": "critical"
    },
    {
      "name": "media file via api.lsevin.com",
      "url": "https://api.lsevin.com/files/Categories/services/019e0f1a-cd9b-da39-b05d-a071f0deda06.jpg",
      "expect": [
        200
      ],
      "for": 120,
      "severity": "critical"
    },
    {
      "name": "CRM (crm.lsevin.com)",
      "url": "https://crm.lsevin.com/api/health",
      "expect": [
        200
      ],
      "for": 180,
      "severity": "critical",
      "cert_days_min": 14
    },
    {
      "name": "providers portal",
      "url": "https://providers.lsevin.com/api/ready",
      "expect": [
        200
      ],
      "for": 180,
      "severity": "critical",
      "cert_days_min": 14
    },
    {
      "name": "Jenkins B (devops.lsevin.com)",
      "url": "https://devops.lsevin.com/login",
      "expect": [
        200
      ],
      "for": 300,
      "severity": "warning",
      "cert_days_min": 14
    },
    {
      "name": "Iranian domain redirect (lsevin.ir via B)",
      "url": "http://lsevin.ir/",
      "expect": [
        302
      ],
      "for": 300,
      "severity": "warning",
      "resolve_ip": "202.133.90.50"
    }
  ],
  "rules": [
    {
      "name": "server_not_reporting",
      "severity": "critical",
      "for": 0,
      "expr": "absent_over_time(lsevin_disk_used_percent{site=\"A\"}[5m])",
      "summary": "Server A has sent no metrics for 5 minutes: it is down, or its VPN link to B is cut. Check the Iranian site from inside Iran."
    },
    {
      "name": "server_b_not_reporting",
      "severity": "critical",
      "for": 0,
      "expr": "absent(lsevin_disk_used_percent{site=\"\"})",
      "summary": "Server B's own exporter is not reporting."
    },
    {
      "name": "site_health_failing",
      "severity": "critical",
      "for": 180,
      "expr": "lsevin_site_ok == 0",
      "summary": "the site's own health checks are failing (see the next alert for which one)"
    },
    {
      "name": "health_check_failed",
      "severity": "critical",
      "for": 180,
      "expr": "lsevin_check == 0",
      "summary": "health check '{check}' fails"
    },
    {
      "name": "probe_failed",
      "severity": "critical",
      "for": 180,
      "expr": "probe_success{instance!~\"http://kibana.*\"} == 0",
      "summary": "{instance} does not answer"
    },
    {
      "name": "target_down",
      "severity": "warning",
      "for": 300,
      "expr": "up{site=\"\"} == 0 or up{site=\"A\",instance!~\"elasticsearch-exporter.*|fluent-bit.*\"} == 0",
      "summary": "metrics target {job}/{instance} is down"
    },
    {
      "name": "deployment_unavailable",
      "severity": "critical",
      "for": 300,
      "expr": "lsevin_deploy_unavailable_replicas > 0",
      "summary": "deployment {deployment} is missing {value} replica(s)"
    },
    {
      "name": "pod_problem",
      "severity": "warning",
      "for": 600,
      "expr": "lsevin_pod_problem == 1",
      "summary": "pod {pod} is stuck: {reason}"
    },
    {
      "name": "pod_restarting",
      "severity": "warning",
      "for": 0,
      "expr": "lsevin_pod_restarts_30m >= 3",
      "summary": "{pod}/{container} restarted {value} times in 30 minutes"
    },
    {
      "name": "k8s_collector_down",
      "severity": "warning",
      "for": 600,
      "expr": "lsevin_k8s_collector_ok == 0",
      "summary": "cannot read Kubernetes state on this server"
    },
    {
      "name": "cpu_high",
      "severity": "warning",
      "for": 600,
      "expr": "100 - avg by (site) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100 > 85",
      "summary": "CPU {value}% for 10 minutes"
    },
    {
      "name": "load_high",
      "severity": "warning",
      "for": 600,
      "expr": "node_load5 > 14",
      "summary": "load average {value} on 8 CPUs"
    },
    {
      "name": "memory_low",
      "severity": "warning",
      "for": 600,
      "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100 < 8",
      "summary": "only {value}% memory available"
    },
    {
      "name": "memory_critical",
      "severity": "critical",
      "for": 300,
      "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100 < 4",
      "summary": "only {value}% memory available: the kernel will start killing processes"
    },
    {
      "name": "swap_high",
      "severity": "warning",
      "for": 900,
      "expr": "(1 - node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes) * 100 > 80",
      "summary": "swap {value}% used"
    },
    {
      "name": "disk_high",
      "severity": "warning",
      "for": 300,
      "expr": "lsevin_disk_used_percent > 80",
      "summary": "disk {value}% full"
    },
    {
      "name": "disk_critical",
      "severity": "critical",
      "for": 120,
      "expr": "lsevin_disk_used_percent > 88",
      "summary": "disk {value}% full: Kubernetes evicts pods above about 85-90%"
    },
    {
      "name": "postgres_connections",
      "severity": "warning",
      "for": 300,
      "expr": "sum by (site) (pg_stat_activity_count) > 100",
      "summary": "{value} database connections (limit 120)"
    },
    {
      "name": "sync_batches_in_error",
      "severity": "critical",
      "for": 120,
      "expr": "lsevin_sync_batches_error > 0",
      "summary": "{value} {direction} replication batch(es) stuck in error: data is NOT being copied between the servers"
    },
    {
      "name": "sync_stalled",
      "severity": "critical",
      "for": 120,
      "expr": "lsevin_sync_last_ok_age_seconds > 900",
      "summary": "no {direction} replication batch moved for {value}s"
    },
    {
      "name": "sync_backlog",
      "severity": "warning",
      "for": 120,
      "expr": "lsevin_sync_outgoing_oldest_pending_seconds > 600",
      "summary": "the oldest undelivered outgoing replication batch is {value}s old"
    },
    {
      "name": "sync_state_unreadable",
      "severity": "warning",
      "for": 300,
      "expr": "lsevin_sync_collector_ok == 0",
      "summary": "cannot read the replication state from the database"
    },
    {
      "name": "db_sync_lag",
      "severity": "critical",
      "for": 300,
      "expr": "lsevin_db_sync_lag_seconds > 600",
      "summary": "database sync lag {value}s"
    },
    {
      "name": "file_sync_stale",
      "severity": "critical",
      "for": 120,
      "expr": "lsevin_file_sync_last_ok_age_seconds > 900",
      "summary": "the two-way file/image sync has not succeeded for {value}s"
    },
    {
      "name": "certificate_expiring",
      "severity": "warning",
      "for": 0,
      "expr": "lsevin_cert_days_left >= 0 and lsevin_cert_days_left < 14",
      "summary": "certificate expires in {value} days"
    },
    {
      "name": "backup_too_old",
      "severity": "critical",
      "for": 0,
      "expr": "lsevin_backup_age_seconds{kind=~\"logical_dump|pgbackrest\"} > 93600",
      "summary": "newest {kind} backup is {value}s old (limit 26 h)"
    },
    {
      "name": "backup_storage_too_old",
      "severity": "warning",
      "for": 0,
      "expr": "lsevin_backup_age_seconds{kind=\"object_storage\"} > 93600",
      "summary": "newest object-storage backup is {value}s old"
    },
    {
      "name": "offsite_copy_too_old",
      "severity": "warning",
      "for": 0,
      "expr": "lsevin_backup_age_seconds{kind=\"offsite_upload\"} > 32400",
      "summary": "the encrypted copy to the other server is {value}s old (limit 9 h)"
    },
    {
      "name": "restore_test_too_old",
      "severity": "warning",
      "for": 0,
      "expr": "lsevin_backup_age_seconds{kind=\"restore_test\"} > 777600",
      "summary": "no successful restore test for {value}s (weekly job)"
    },
    {
      "name": "jenkins_build_failed",
      "severity": "warning",
      "for": 0,
      "expr": "lsevin_jenkins_last_build_result == 0 and lsevin_jenkins_last_build_age_seconds < 86400",
      "summary": "the last build of {job} FAILED"
    },
    {
      "name": "jenkins_repeated_failures",
      "severity": "critical",
      "for": 0,
      "expr": "lsevin_jenkins_consecutive_failures >= 3 and lsevin_jenkins_last_build_age_seconds < 86400",
      "summary": "{job}: {value} builds failed in a row"
    },
    {
      "name": "sms_provider_login_failed",
      "severity": "critical",
      "for": 300,
      "expr": "lsevin_provider_api_ok{provider=\"melipayamak\"} == 0",
      "summary": "MeliPayamak (SMS OTP for Iranian numbers) rejects our login or is unreachable: login SMS will fail"
    },
    {
      "name": "sms_credit_low",
      "severity": "warning",
      "for": 0,
      "expr": "lsevin_provider_credit{provider=\"melipayamak\"} >= 0 and lsevin_provider_credit{provider=\"melipayamak\"} < 300",
      "summary": "MeliPayamak SMS credit is low: {value}"
    },
    {
      "name": "provider_unreachable",
      "severity": "warning",
      "for": 300,
      "expr": "lsevin_provider_reachable{provider=\"melipayamak\"} == 0 or lsevin_provider_reachable{provider=\"whatsiplus\",site!=\"A\"} == 0",
      "summary": "cannot open a connection to {provider}'s API"
    },
    {
      "name": "provider_send_errors",
      "severity": "critical",
      "for": 0,
      "expr": "lsevin_provider_sends_15m{result=\"error\"} >= 3 and on(provider, site) lsevin_provider_sends_15m{result=\"ok\"} == 0",
      "summary": "{provider}: {value} failed sends and no successful one in 15 minutes (real user OTPs are failing)"
    }
  ]
}