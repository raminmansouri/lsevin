#!/usr/bin/env bash
set -Eeuo pipefail
BACKUP_DIR=/opt/lsevin/backups/logical
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$BACKUP_DIR"
exec 9>/run/lock/lsevin-database-backup.lock
flock -w 7200 9 || { echo 'Timed out waiting for another database backup.' >&2; exit 1; }
DB_NAME=lsevin
FILE="$BACKUP_DIR/$DB_NAME-$TIMESTAMP.dump"
CONTAINER_ID="$(k3s crictl ps --label io.kubernetes.container.name=postgres -q | head -n 1)"
[[ -n "$CONTAINER_ID" ]] || { echo 'PostgreSQL container was not found.' >&2; exit 1; }
k3s ctr -n k8s.io tasks exec --exec-id "logical-backup-$TIMESTAMP" "$CONTAINER_ID" \
  sh -lc 'exec pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom --compress=9 --no-owner --no-privileges' \
  > "$FILE"
test -s "$FILE"
VERIFY_HOST_FILE="/var/lib/docker/volumes/docker_postgres_data/_data/.lsevin-backup-verify-$TIMESTAMP.dump"
VERIFY_CONTAINER_FILE="/var/lib/postgresql/data/$(basename "$VERIFY_HOST_FILE")"
trap 'rm -f -- "$VERIFY_HOST_FILE"' EXIT
cp --reflink=auto "$FILE" "$VERIFY_HOST_FILE"
chmod 0644 "$VERIFY_HOST_FILE"
k3s ctr -n k8s.io tasks exec --exec-id "logical-verify-$TIMESTAMP" "$CONTAINER_ID" \
  pg_restore --list "$VERIFY_CONTAINER_FILE" >/dev/null
rm -f -- "$VERIFY_HOST_FILE"
trap - EXIT
find "$BACKUP_DIR" -maxdepth 1 -type f -name "$DB_NAME-*.dump" -mtime +14 -delete
echo "Logical backup verified: $FILE"
