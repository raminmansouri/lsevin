# /etc/lsevin-dr/site.env on SERVER A (Iran). A reaches B's store through the file-sync SSH tunnel (see rclone.conf [s3]).
SITE=A
BUCKET=lsevin-media
DUMP_DIR=/var/backups/lsevin/db
CONFIG_OUT=/var/backups/lsevin/config
BWLIMIT=6M
CONFIG_PATHS="/etc/lsevin /etc/lsevin-certs /etc/lsevin-files /etc/openvpn /var/lib/lsevin-vpn /etc/hosts /etc/fstab /etc/cron.d/lsevin-backups /etc/sysctl.d /etc/rancher/k3s /root/.ssh /opt/lsevin/caddy/Caddyfile /opt/lsevin/app/deployments/docker/.env /opt/lsevin/app/deployments/jenkins/.env /opt/lsevin/app/deployments/jenkins/docker-compose.override.yml /opt/symds/node-a/engines /opt/symds/node-a/conf /usr/local/sbin/lsevin-* /usr/local/sbin/build-site-variant /etc/systemd/system/lsevin-* /var/lib/lsevin/jenkins/config.xml /var/lib/lsevin/jenkins/credentials.xml /var/lib/lsevin/jenkins/secrets /var/lib/lsevin/jenkins/users /var/lib/lsevin/jenkins/casc"
