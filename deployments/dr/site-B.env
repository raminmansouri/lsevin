# /etc/lsevin-dr/site.env on SERVER B (global). B writes to its own local SeaweedFS store (see rclone.conf [s3]).
SITE=B
BUCKET=lsevin-media
DUMP_DIR=/opt/lsevin/backups/logical
CONFIG_OUT=/var/backups/lsevin/config
BWLIMIT=20M
CONFIG_PATHS="/etc/lsevin /etc/lsevin-acme /etc/hosts /etc/fstab /etc/sysctl.d /etc/rancher/k3s /opt/lsevin/app/deployments/docker/.env /opt/lsevin/app/deployments/docker/Caddyfile.server /opt/lsevin/config /opt/symds/hub/engines /opt/symds/hub/conf /var/lib/filesync/.ssh /var/lib/filesync/certs /usr/local/sbin/lsevin-* /usr/local/sbin/grant-backup-download-access /etc/systemd/system/lsevin-* /var/lib/lsevin/jenkins/config.xml /var/lib/lsevin/jenkins/credentials.xml /var/lib/lsevin/jenkins/secrets /var/lib/lsevin/jenkins/users /var/lib/lsevin/jenkins/casc"
