template IN A lsevin.ir {
  match "^(www[.])?lsevin[.]ir[.]$"
  answer "{{ .Name }} 60 IN A 213.176.121.235"
  fallthrough
}
# AAAA: without this rule AAAA queries go to the upstream resolver, time out, and Node's getaddrinfo fails with EAI_AGAIN
# (the Next.js image optimizer fetches https://lsevin.ir/files/... from inside the pod). Answer 'no IPv6 address' immediately.
template IN AAAA lsevin.ir {
  match "^(www[.])?lsevin[.]ir[.]$"
  rcode NOERROR
}
