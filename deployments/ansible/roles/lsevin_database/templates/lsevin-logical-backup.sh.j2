#!/usr/bin/env bash
set -Eeuo pipefail
BACKUP_DIR={{ lsevin_backup_dir }}/logical
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
FILE="$BACKUP_DIR/{{ vault_postgres_db }}-$TIMESTAMP.dump"
mkdir -p "$BACKUP_DIR"
exec 9>/run/lock/lsevin-database-backup.lock
flock -w 7200 9 || { echo 'Timed out waiting for another database backup.' >&2; exit 1; }
cd {{ lsevin_app_dir }}/deployments/docker
docker compose --project-name {{ lsevin_compose_project }} --env-file .env -f docker-compose.server.yml   exec -T postgres pg_dump -U {{ vault_postgres_user | quote }} -d {{ vault_postgres_db | quote }}   --format=custom --compress=9 --no-owner --no-privileges > "$FILE"
test -s "$FILE"
docker compose --project-name {{ lsevin_compose_project }} --env-file .env -f docker-compose.server.yml   exec -T postgres pg_restore --list < "$FILE" >/dev/null
find "$BACKUP_DIR" -maxdepth 1 -type f -name '{{ vault_postgres_db }}-*.dump'   -mtime +{{ logical_backup_retention_days }} -delete
echo "Logical backup verified: $FILE"
