# Managed by Ansible. Change inventory variables, not this live file.
listen_addresses = '*'
port = 5432
max_connections = {{ postgres_max_connections }}
superuser_reserved_connections = 5
password_encryption = 'scram-sha-256'

# Memory is calculated from detected host RAM. This server also runs application
# containers, so shared_buffers defaults to 20%, not the 25% dedicated-DB value.
shared_buffers = '{{ postgres_shared_buffers_mb }}MB'
effective_cache_size = '{{ postgres_effective_cache_size_mb }}MB'
work_mem = '{{ postgres_work_mem_mb }}MB'
maintenance_work_mem = '{{ postgres_maintenance_work_mem_mb }}MB'
autovacuum_work_mem = '{{ postgres_autovacuum_work_mem_mb }}MB'
huge_pages = try

# OLTP planner/I/O defaults for SSD-backed storage.
jit = off
random_page_cost = {{ '1.1' if postgres_storage_type == 'ssd' else '4.0' }}
seq_page_cost = 1.0
effective_io_concurrency = {{ '200' if postgres_storage_type == 'ssd' else '2' }}
maintenance_io_concurrency = {{ '200' if postgres_storage_type == 'ssd' else '2' }}
default_statistics_target = 200

max_worker_processes = {{ postgres_max_worker_processes }}
max_parallel_workers = {{ postgres_max_parallel_workers }}
max_parallel_workers_per_gather = {{ postgres_max_parallel_workers_per_gather }}
max_parallel_maintenance_workers = {{ postgres_max_parallel_maintenance_workers }}

# Durable WAL/checkpoint settings. fsync, full_page_writes, and synchronous_commit
# intentionally remain on.
checkpoint_timeout = '15min'
checkpoint_completion_target = 0.9
min_wal_size = '{{ postgres_min_wal_size_gb }}GB'
max_wal_size = '{{ postgres_max_wal_size_gb }}GB'
wal_compression = on
wal_level = replica
wal_keep_size = '512MB'
max_wal_senders = 10
max_replication_slots = 10
max_slot_wal_keep_size = '4GB'
archive_mode = on
archive_timeout = '5min'
archive_command = 'pgbackrest --stanza=lsevin archive-push %p || exit 1'
restore_command = 'pgbackrest --stanza=lsevin archive-get %f "%p" || exit 1'

# Query visibility and diagnostics.
shared_preload_libraries = 'pg_stat_statements,auto_explain'
compute_query_id = auto
pg_stat_statements.max = 10000
pg_stat_statements.track = all
pg_stat_statements.save = on
track_io_timing = on
track_wal_io_timing = on
track_activity_query_size = 4096
track_functions = pl
log_destination = 'stderr'
logging_collector = off
log_line_prefix = '%m [%p] %q%u@%d app=%a client=%h '
log_min_duration_statement = {{ postgres_log_slow_query_ms }}
log_checkpoints = on
log_lock_waits = on
log_temp_files = '64MB'
deadlock_timeout = '1s'
auto_explain.log_min_duration = '5s'
auto_explain.log_analyze = off
auto_explain.log_buffers = on
auto_explain.log_nested_statements = on

# Protect the server from leaked sessions and runaway temporary files without
# applying a dangerous global statement_timeout.
idle_in_transaction_session_timeout = '5min'
temp_file_limit = '10GB'
max_locks_per_transaction = 128
max_pred_locks_per_transaction = 128
timezone = 'UTC'

# More responsive autovacuum for an OLTP platform with frequently changing rows.
autovacuum = on
autovacuum_max_workers = {{ postgres_autovacuum_max_workers }}
autovacuum_naptime = '15s'
autovacuum_vacuum_threshold = 50
autovacuum_analyze_threshold = 50
autovacuum_vacuum_scale_factor = 0.05
autovacuum_analyze_scale_factor = 0.02
autovacuum_vacuum_insert_scale_factor = 0.05
autovacuum_vacuum_cost_limit = 2000
autovacuum_vacuum_cost_delay = '2ms'
