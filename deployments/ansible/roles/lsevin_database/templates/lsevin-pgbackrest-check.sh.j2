#!/usr/bin/env bash
set -Eeuo pipefail
exec 9>/run/lock/lsevin-database-backup.lock
flock -w 7200 9 || { echo 'Timed out waiting for another database backup.' >&2; exit 1; }
cd {{ lsevin_app_dir }}/deployments/docker
docker compose --project-name {{ lsevin_compose_project }} --env-file .env -f docker-compose.server.yml   exec -T --user postgres postgres pgbackrest --stanza=lsevin check
