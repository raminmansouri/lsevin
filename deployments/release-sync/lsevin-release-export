#!/usr/bin/env bash
# lsevin-release-export - runs ON SERVER B (timer, every 2 minutes). Publishes the application images that B is running right now,
# so server A can take exactly the same release instead of building it itself (A has 7.9 GB RAM; a Next.js build needs ~3 GB and
# repeatedly starved the live site / was refused by the build gate).
#
#   output   /var/lib/lsevin/release-export/<image>.tar.gz   one OCI archive per image tag, written once
#            /var/lib/lsevin/release-export/current.json     what B runs now: commit, image refs, sha256, size, time
#   served   by lsevin-release-server (bridge address only) behind Caddy's password-protected /_releases/ route
#
# Only images of a FULLY rolled-out deployment are published, so A never receives a release that B itself rolled back.
set -euo pipefail
OUT=${OUT:-/var/lib/lsevin/release-export}; NS=${NS:-lsevin}; KEEP=${KEEP:-9}
K=${KUBECTL:-kubectl}; command -v "$K" >/dev/null 2>&1 || K="k3s kubectl"; [ "$(id -u)" = 0 ] || K="sudo -n $K"
CTR="k3s ctr -n k8s.io"; [ "$(id -u)" = 0 ] || CTR="sudo -n $CTR"
LOG=${LOG:-/var/log/lsevin-release-export.log}
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG" 2>/dev/null || true; }
exec 9>/run/lock/lsevin-release-export.lock 2>/dev/null || exec 9>/tmp/lsevin-release-export.lock; flock -n 9 || exit 0
mkdir -p "$OUT"

rolled_out() {  # rolled_out <deployment>: desired == updated == ready == available and no surge pods left
  $K -n "$NS" get deploy "$1" -o jsonpath='{.spec.replicas} {.status.updatedReplicas} {.status.readyReplicas} {.status.availableReplicas} {.status.replicas}' \
    | awk '{ if ($1 > 0 && $1 == $2 && $1 == $3 && $1 == $4 && $1 == $5) ok = 1 } END { exit ok ? 0 : 1 }'
}
rolled_out lsevin-webapp && rolled_out lsevin-api || { log "skip: a deployment is not fully rolled out"; exit 0; }

web=$($K -n "$NS" get deploy lsevin-webapp -o jsonpath='{.spec.template.spec.containers[?(@.name=="web")].image}')
mig=$($K -n "$NS" get deploy lsevin-webapp -o jsonpath='{.spec.template.spec.initContainers[?(@.name=="migrate")].image}')
api=$($K -n "$NS" get deploy lsevin-api -o jsonpath='{.spec.template.spec.containers[?(@.name=="api")].image}')
[ -n "$web" ] && [ -n "$api" ] || { log "skip: could not read the deployed images"; exit 0; }

file_of() { printf '%s/%s.tar.gz' "$OUT" "$(printf '%s' "$1" | tr ':/' '__')"; }
for ref in $web $mig $api; do
  [ -n "$ref" ] || continue
  f=$(file_of "$ref")
  if [ ! -s "$f" ]; then
    log "exporting $ref"
    $CTR images export - "docker.io/library/$ref" 2>/dev/null | gzip -1 > "$f.part" && [ -s "$f.part" ] || { rm -f "$f.part"; log "FAILED to export $ref"; exit 1; }
    mv -f "$f.part" "$f"
  fi
  [ -s "$f.sha256" ] || sha256sum "$f" | cut -d' ' -f1 > "$f.sha256"
done

entry() { [ -n "$1" ] || { printf 'null'; return; }; f=$(file_of "$1"); printf '{"ref":"%s","file":"%s","sha256":"%s","bytes":%s}' "$1" "$(basename "$f")" "$(cat "$f.sha256")" "$(stat -c %s "$f")"; }
tmp=$(mktemp "$OUT/.current.XXXXXX")
printf '{"created":"%s","commit":"%s","webapp":%s,"migrations":%s,"api":%s}\n' "$(date -u +%FT%TZ)" "$(printf '%s' "${web#*:}" | cut -c1-12)" "$(entry "$web")" "$(entry "$mig")" "$(entry "$api")" > "$tmp"
chmod 644 "$tmp"; mv -f "$tmp" "$OUT/current.json"

# keep the files of the current release and the newest ones; remove the rest
keepfiles=$( (for ref in $web $mig $api; do basename "$(file_of "$ref")"; done; ls -1t "$OUT" | grep -E '\.tar\.gz$' | head -n "$KEEP") | sort -u)
for f in "$OUT"/*.tar.gz; do [ -e "$f" ] || continue; echo "$keepfiles" | grep -qxF "$(basename "$f")" || { rm -f "$f" "$f.sha256"; log "pruned $(basename "$f")"; }; done
exit 0
