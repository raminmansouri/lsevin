NEXT_PUBLIC_URL=https://appmain.lsevin.com
# Same-origin, routed through appmain's own Caddy /api/v1 matcher straight to
# lsevin-api — this is what production actually runs. api.lsevin.com is a
# second, independent public entrypoint to the same API (used by mobile
# clients / NEXT_PUBLIC_API_URL in the standalone subdomain apps), not by
# this webapp's own browser calls.
NEXT_PUBLIC_API_URL=https://appmain.lsevin.com/api/v1
NEXT_PUBLIC_FILES_URL=https://appmain.lsevin.com/files
NEXT_PUBLIC_SOCKET_URL=https://appmain.lsevin.com/hubs
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_NESHAN_MAP_KEY=

AUTH_URL=https://appmain.lsevin.com
AUTH_SECRET=CHANGE_ME_LONG_RANDOM
WEBHOOK_KEY=CHANGE_ME_LONG_RANDOM
WEBAPP_API_KEY=CHANGE_ME_LONG_RANDOM
# Encrypts Next.js Server Actions payloads. Independent of AUTH_SECRET — use a
# separate random value, not the same secret used anywhere else.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM
# Lets a cookie set on appmain also apply to providers/shop/crm subdomains.
NEXT_PUBLIC_LSEVIN_COOKIE_DOMAIN=.lsevin.com

POSTGRES_DB=lsevin
POSTGRES_USER=lsevin
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Read-only role for postgres-exporter/pgbouncer-exporter. Never used for app traffic.
POSTGRES_MONITOR_USER=lsevin_monitor
POSTGRES_MONITOR_PASSWORD=CHANGE_ME_MONITOR_PASSWORD
POSTGRES_IMAGE_TAG=17.10-alpine
# Tune to your server's RAM; too small causes PostgreSQL OOM under load.
POSTGRES_SHM_SIZE=512m
# Host-published ports for postgres/pgbouncer. Only needed if the default
# 5432/6432 already clashes with something else on the host (common in local
# testing) — leave unset in production.
# POSTGRES_HOST_PORT=5432
# PGBOUNCER_HOST_PORT=6432

JWT_ISSUER=https://api.lsevin.com
JWT_AUDIENCE=lsevin-api
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Connection strings used by the webapp (Next.js talks to PgBouncer for normal
# traffic; DIRECT bypasses the pooler for maintenance/one-off scripts).
DATABASE_URL=postgres://lsevin:CHANGE_ME_DB_PASSWORD@pgbouncer:6432/lsevin
DATABASE_URL_DIRECT=postgres://lsevin:CHANGE_ME_DB_PASSWORD@postgres:5432/lsevin

# Server-to-server base address; never leaves the Docker network.
INTERNAL_API_URL=http://lsevin-api:8080/api/v1

PGBOUNCER_VERSION=1.25.2
# PgBouncer's own admin account. Not the Postgres superuser.
PGBOUNCER_ADMIN_USER=pgbouncer_admin
PGBOUNCER_ADMIN_PASSWORD=CHANGE_ME_PGBOUNCER_PASSWORD
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_MAX_DB_CONNECTIONS=90
PGBOUNCER_MAX_USER_CONNECTIONS=90
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# Bind-mounted config/backup directories on the host (see docker-compose.server.yml).
LSEVIN_CONFIG_DIR=/opt/lsevin/config
LSEVIN_BACKUP_DIR=/opt/lsevin/backups

# Wired to CorsOptions__AllowedUrls__0..3 on the API — one entry per public app.
CORS_ORIGIN_1=https://appmain.lsevin.com
CORS_ORIGIN_2=https://providers.lsevin.com
CORS_ORIGIN_3=https://shop.lsevin.com
CORS_ORIGIN_4=https://crm.lsevin.com

# --- Providers Portal SSO ---------------------------------------------------
# Read by src/lib/auth/provider-portal-sso.ts. Required so provider SSO does
# not silently depend on AUTH_SECRET; at least 32 random characters.
LSEVIN_SSO_SECRET=CHANGE_ME_LONG_RANDOM
# Keep false in production — true renders an HTML diagnostic page on SSO failures.
LSEVIN_SSO_DEBUG=false
LSEVIN_PROVIDER_PORTAL_URL=https://providers.lsevin.com

# OTP for international (non-Iran) numbers is delivered via WhatsiPlus (WhatsApp).
# Secret — set the real key here; leave blank to disable international OTP.
WHATSIPLUS_API_KEY=CHANGE_ME_WHATSIPLUS_KEY

SEQ_URL=

# Public hostnames used by Caddy.
APP_DOMAIN=appmain.lsevin.com
API_DOMAIN=api.lsevin.com
PROVIDERS_DOMAIN=providers.lsevin.com
SHOP_DOMAIN=shop.lsevin.com
CRM_DOMAIN=crm.lsevin.com
JENKINS_DOMAIN=devops.lsevin.com
# Served by Caddyfile.server but previously absent here, which made it invisible
# configuration relying on the built-in fallback.
FINANCIAL_DOMAIN=financial.lsevin.com
CADDY_ACME_EMAIL=admin@lsevin.com

# Durable paths outside the repository.
LSEVIN_UPLOADS_DIR=/var/lib/lsevin/uploads
LSEVIN_MINIO_DIR=/var/lib/lsevin/minio

# --- Object storage for uploaded media -------------------------------------
#
# Start at FileSystem. Switch to Minio only after the bucket exists, its policy is
# applied and the existing uploads have been mirrored into it. While the files are
# still on disk, switching back is the rollback.
FILE_STORAGE_BACKEND=FileSystem

MINIO_BUCKET=lsevin-media

# Console/administration account. The application never uses these.
MINIO_ROOT_USER=lsevin-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM

# Scoped service account the API uses: Get/Put/DeleteObject on the media bucket and
# nothing else. Create it with `mc admin user svcacct add` and paste the pair here.
MINIO_API_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_API_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

