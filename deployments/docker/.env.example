# OTP for international (non-Iran) numbers is delivered via WhatsiPlus (WhatsApp).
# Secret — set the real key here; leave blank to disable international OTP.
WHATSIPLUS_API_KEY=CHANGE_ME_WHATSIPLUS_KEY

SEQ_URL=

# Public hostnames used by Caddy.
APP_DOMAIN=appmain.lsevin.com
API_DOMAIN=api.lsevin.com
PROVIDERS_DOMAIN=providers.lsevin.com
SHOP_DOMAIN=shop.lsevin.com
CRM_DOMAIN=crm.lsevin.com
JENKINS_DOMAIN=devops.lsevin.com
