[databases]
* = host=postgres port=5432

# Session-pooled alias for the .NET API.
#
# The API cannot use the transaction-pooled default: it runs EF Core migrations
# on startup (BuildingBlocks.Core.Persistence.MigrationWorker, registered as a
# hosted service for every module), and EF takes a session-scoped advisory lock
# that it holds across several statements. Under pool_mode = transaction
# PgBouncer is free to hand each of those statements a different backend, so the
# lock is taken on one connection and released on another — at best the
# migration lock does nothing, at worst two instances migrate concurrently.
# Npgsql's own connection pool also assumes a stable session (DISCARD ALL on
# close, SET statements, prepared statements).
#
# Session pooling still gives the API everything PgBouncer is here for — a
# bounded, reusable set of backend connections in front of PostgreSQL — while
# behaving exactly like a direct connection from the client's point of view.
# Use this alias for anything that migrates, takes advisory locks, or issues
# LISTEN/NOTIFY; use the transaction-pooled default for stateless request
# traffic like the Next.js webapp.
__APP_DB___session = host=postgres port=5432 dbname=__APP_DB__ pool_mode=session

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir = /tmp
pidfile = /tmp/pgbouncer.pid
auth_type = scram-sha-256
auth_file = /tmp/userlist.txt
admin_users = __ADMIN_USER__
stats_users = __STATS_USER__
pool_mode = transaction
max_client_conn = __MAX_CLIENT_CONN__
default_pool_size = __DEFAULT_POOL_SIZE__
min_pool_size = __MIN_POOL_SIZE__
reserve_pool_size = __RESERVE_POOL_SIZE__
reserve_pool_timeout = 3
max_db_connections = __MAX_DB_CONNECTIONS__
max_user_connections = __MAX_USER_CONNECTIONS__
max_prepared_statements = __MAX_PREPARED_STATEMENTS__
server_lifetime = 3600
server_idle_timeout = 600
server_connect_timeout = 5
server_login_retry = 5
query_wait_timeout = 30
client_login_timeout = 60
cancel_wait_timeout = 10
idle_transaction_timeout = 300
server_reset_query = DISCARD ALL
ignore_startup_parameters = extra_float_digits
application_name_add_host = 1
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
stats_period = 60
tcp_keepalive = 1
tcp_keepcnt = 5
tcp_keepidle = 60
tcp_keepintvl = 15
client_tls_sslmode = disable
server_tls_sslmode = disable
