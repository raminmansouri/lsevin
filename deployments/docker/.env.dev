# Local development env for docker-compose.dev.yml — NOT for any server.
# Everything here is a throwaway local credential.

COMPOSE_PROJECT_NAME=lsevin-dev

POSTGRES_DB=lsevin
POSTGRES_USER=lsevin
POSTGRES_PASSWORD=lsevin
POSTGRES_IMAGE_TAG=17.10-alpine
