appmain.lsevin.com {

  @next_internal {
    path /_next/* /images/*
  }

  reverse_proxy @next_internal lsevin-webapp:3000 {
    flush_interval -1
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
  }

  @auth {
    path /api/auth/*
  }
  reverse_proxy @auth lsevin-webapp:3000

  @backend {
    path /api/* /files/* /hubs/*
  }
  reverse_proxy @backend lsevin-apigateway:8080

  reverse_proxy lsevin-webapp:3000
}
