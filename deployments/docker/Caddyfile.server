{
	email {$CADDY_ACME_EMAIL:admin@lsevin.com}

	# Custom GeoIP plugin included by caddy.Dockerfile.
	order geoip2_vars first
	geoip2 {
		databaseDirectory "/etc/caddy/geoip"
		editionID "dbip-country-lite"
		updateFrequency 0
	}
}

(common_headers) {
	encode zstd gzip
	header {
		-X-Powered-By
		# Caddy's Server: Caddy carries no functional meaning for clients and only
		# advertises the stack. MinIO's own Server header is already stripped on
		# the /files/* handlers; this covers everything else.
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"

		# One year. Deliberately NO includeSubDomains and NO preload yet — every
		# lsevin.com subdomain must be confirmed HTTPS-only first, and preload is
		# irreversible. Only sent on :443 responses (the :80 vhost is Caddy's
		# auto HTTP->HTTPS redirect and never imports this snippet).
		Strict-Transport-Security "max-age=31536000"

		# camera/microphone: no code in any of the three apps calls getUserMedia.
		# geolocation=(self): the webapp's "current location" picker, map-discovery
		# NearbyClient and privacy-security page all call navigator.geolocation, so
		# it must stay allowed for our own origin — just not for third parties or
		# embedded frames.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

		# First-pass enforcing policy. Intentionally broad (`https:` wildcards,
		# 'unsafe-inline', 'unsafe-eval') so it cannot break the running apps;
		# every relaxation below is load-bearing:
		#   script-src 'unsafe-inline'  -> Next.js App Router streams inline
		#     <script>self.__next_f.push(...)</script> chunks with no nonce
		#     threaded through Caddy.
		#   script-src 'unsafe-eval'    -> mapbox-gl / react-map-gl (transpiled in
		#     next.config.ts) use Function()/eval in some code paths.
		#   style-src 'unsafe-inline'   -> Next.js critical CSS and next/font emit
		#     inline <style>.
		#   connect-src wss:            -> SignalR realtime hub
		#     (NEXT_PUBLIC_SOCKET_URL -> wss://appmain.lsevin.com/hubs).
		#   worker-src blob:            -> mapbox-gl web workers, Next.js.
		#   frame-ancestors 'self'      -> same protection as the X-Frame-Options
		#     above, which is already live and does not break provider<->appmain
		#     SSO (that flow is top-level redirects, not framing).
		#   NO form-action              -> payment-gateway flows POST forms to
		#     external acquirer URLs.
		# Future hardening: replace `https:` with explicit origins (GTM, Hotjar,
		# mapbox, neshan tiles, enamad trustseal, fonts) and drop the unsafe-*
		# tokens via a nonce/hash strategy.
		Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https: wss:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
	}
	log {
		output stdout
		format console
	}
}

# Main Next.js application. API/file/hub traffic on the same host is sent to .NET.
{$APP_DOMAIN:appmain.lsevin.com} {
	import common_headers
	geoip2_vars strict

	@backend path /api/v1/* /hubs/* /hubs /hc /liveness /readiness
	handle @backend {
		reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$API_NODE_PORT:30081} {
			# Replace client-supplied forwarding chains before API rate limiting.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Public media is streamed by the API from private SeaweedFS storage. The API
	# permits only Categories/* and ServiceProviders/*; customer documents stay private.
	handle_path /files/* {
		header Cache-Control "public,max-age=31536000,immutable"
		header -Server
		rewrite * /files{uri}
		reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$API_NODE_PORT:30081} {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Two replicas (Jenkinsfile.main recreates them one at a time) so a deploy
	# never tears down the only Next.js process in existence — the other
	# replica keeps serving with its in-memory caches already warm while the
	# one being redeployed restarts. Same round_robin + health_uri pattern as
	# crm/providers/shop below.
	handle {
		reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$WEBAPP_NODE_PORT:30080} {
			header_up X-Country {geoip2.country_code}
			lb_policy round_robin
			health_uri /sw.js
			health_interval 5s
			health_timeout 3s
			fail_duration 10s
			max_fails 1
			lb_try_duration 5s
		}
	}
}

# Public API hostname used by NEXT_PUBLIC_API_URL and mobile clients.
{$API_DOMAIN:api.lsevin.com} {
	import common_headers

	# Public media is streamed by the API from private SeaweedFS storage.
	handle_path /files/* {
		header Cache-Control "public,max-age=31536000,immutable"
		header -Server
		rewrite * /files{uri}
		reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$API_NODE_PORT:30081} {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$API_NODE_PORT:30081} {
			header_up X-Forwarded-For {remote_host}
			lb_try_duration 5s
			fail_duration 30s
		}
	}
}

# CRM, Providers, and Shop each run two replicas.
{$CRM_DOMAIN:crm.lsevin.com} {
    import common_headers

    reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$CRM_NODE_PORT:30082} {
        # Share requests across both healthy replicas.
        lb_policy round_robin

        # Test each replica directly every five seconds.
        health_uri /api/health
        health_interval 5s
        health_timeout 3s

        # Stop using a replica quickly after connection failures.
        fail_duration 10s
        max_fails 1

        # Retry another healthy replica before returning an error to the visitor.
        lb_try_duration 5s
    }
}

{$PROVIDERS_DOMAIN:providers.lsevin.com} {
    import common_headers

    reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$PROVIDERS_NODE_PORT:30083} {
        lb_policy round_robin
        health_uri /api/health
        health_interval 5s
        health_timeout 3s
        fail_duration 10s
        max_fails 1
        lb_try_duration 5s
    }
}

{$SHOP_DOMAIN:shop.lsevin.com} {
    import common_headers

    reverse_proxy lsevin-shop-1:3000 lsevin-shop-2:3000 {
        lb_policy round_robin
        health_uri /api/health
        health_interval 5s
        health_timeout 3s
        fail_duration 10s
        max_fails 1
        lb_try_duration 5s
    }
}

# Jenkins administration website.
#
# Caddy automatically forwards:
# - Host
# - X-Forwarded-Host
# - X-Forwarded-Proto
# - X-Forwarded-For
#
# Therefore, manually adding these headers is unnecessary.
# The accounting panel. Same webapp image as appmain, but a separate product: the
# middleware serves only /financial on this host and 404s that path on every other one,
# and the panel authenticates against accounting.panel_users rather than the platform's
# admin session. An admin cookie is worth nothing here, and a panel cookie is worth
# nothing on appmain.
#
# It rides the same two webapp replicas as appmain (round_robin + health_uri, the
# crm/providers/shop pattern), so it gets Jenkins' rolling deploy and the real
# .env for free. It used to point at a bare `lsevin-webapp:3000`, which resolved
# only to a hand-run orphan container from the pre-`-1`/`-2` compose layout —
# stale image, no .env mount, updated by nobody.
{$FINANCIAL_DOMAIN:financial.lsevin.com} {
    import common_headers

    # The books are not for search engines, and must never be framed.
    # This header block runs after `import common_headers`, so these three
    # fields override the shared values, and the CSP is re-stated with
    # frame-ancestors 'none' (modern browsers honour CSP frame-ancestors over
    # X-Frame-Options, so the shared 'self' would otherwise weaken DENY here).
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https: wss:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    }

    reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$WEBAPP_NODE_PORT:30080} {
        lb_policy round_robin
        health_uri /sw.js
        health_interval 5s
        health_timeout 3s
        fail_duration 10s
        max_fails 1
        lb_try_duration 5s
    }
}

{$JENKINS_DOMAIN:devops.lsevin.com} {
	import common_headers

	reverse_proxy lsevin-jenkins:8080
}

# Grafana provides its own authenticated login page.
{$GRAFANA_DOMAIN:grafana.lsevin.com} {
	import common_headers

	reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$GRAFANA_NODE_PORT:30084}
}

# Kibana is protected at the TLS edge because Elasticsearch application
# security is not enabled in the current single-node migration topology.
{$KIBANA_DOMAIN:kibana.lsevin.com} {
	import common_headers

	basic_auth {
		admin $2a$14$xg5bHB9RxcIJBjCskvlLf.a7ZEpbkvSRfGRxmE32JaALnOCSAqM.y
	}

	reverse_proxy {$K3S_NODE_ADDRESS:172.18.0.1}:{$KIBANA_NODE_PORT:30085}
}
