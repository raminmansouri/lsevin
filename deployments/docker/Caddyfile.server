{
	email {$CADDY_ACME_EMAIL:admin@lsevin.com}

	# Custom GeoIP plugin included by caddy.Dockerfile.
	order geoip2_vars first
	geoip2 {
		databaseDirectory "/etc/caddy/geoip"
		editionID "dbip-country-lite"
		updateFrequency 0
	}
}

(common_headers) {
	encode zstd gzip
	header {
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
	log {
		output stdout
		format console
	}
}

# Main Next.js application. API/file/hub traffic on the same host is sent to .NET.
{$APP_DOMAIN:appmain.lsevin.com} {
	import common_headers
	geoip2_vars strict

	@backend path /api/v1/* /hubs/* /hubs /hc /liveness /readiness
	handle @backend {
		reverse_proxy lsevin-api:8080
	}

	# Media reads are served straight from object storage; the API is not in the read
	# path. Caddy strips /files, prefixes the bucket name and proxies to MinIO.
	#
	# The immutable cache header MUST be set here. It previously came from
	# UseFileUploadService's OnPrepareResponse inside .NET, and that code no longer runs
	# for these requests — without this line browser and CDN caching would silently
	# vanish. Stored filenames are content-unique, so immutable remains correct.
	#
	# Only Categories/* and ServiceProviders/* are anonymously readable in the bucket.
	# Everything else — CustomerDocument/* above all — returns 403 instead of being
	# handed to anyone who knows the path, which is stricter than the .NET static file
	# handler ever was.
	handle_path /files/* {
		header Cache-Control "public,max-age=31536000,immutable"
		header -Server
		rewrite * /lsevin-media{uri}
		reverse_proxy minio:9000 {
			# Fall back to the .NET static handler when the object is not in the bucket.
			# Without this there is a hole between Caddy reading from MinIO and the API
			# still writing to disk: anything uploaded in between would 404 even though
			# the file exists. It also covers the delta between the mirror and cutover.
			#
			# Deliberately 404 only, never 403. MinIO answers 403 for any prefix the
			# anonymous policy does not cover — CustomerDocument/* above all — and falling
			# back there would hand those files straight to the unauthenticated .NET static
			# handler, undoing the one access-control gain of this change.
			@absent status 404
			handle_response @absent {
				# A single directive rather than strip_prefix plus rewrite: Caddy applies its
				# own directive order inside handle_response, where rewrite runs first and
				# yields /files/lsevin-media/... instead of /files/...
				uri replace /lsevin-media /files 1
				reverse_proxy lsevin-api:8080
			}
		}
	}

	handle {
		reverse_proxy lsevin-webapp:3000 {
			header_up X-Country {geoip2.country_code}
		}
	}
}

# Public API hostname used by NEXT_PUBLIC_API_URL and mobile clients.
{$API_DOMAIN:api.lsevin.com} {
	import common_headers

	# Media reads are served straight from object storage; the API is not in the read
	# path. Caddy strips /files, prefixes the bucket name and proxies to MinIO.
	#
	# The immutable cache header MUST be set here. It previously came from
	# UseFileUploadService's OnPrepareResponse inside .NET, and that code no longer runs
	# for these requests — without this line browser and CDN caching would silently
	# vanish. Stored filenames are content-unique, so immutable remains correct.
	#
	# Only Categories/* and ServiceProviders/* are anonymously readable in the bucket.
	# Everything else — CustomerDocument/* above all — returns 403 instead of being
	# handed to anyone who knows the path, which is stricter than the .NET static file
	# handler ever was.
	handle_path /files/* {
		header Cache-Control "public,max-age=31536000,immutable"
		header -Server
		rewrite * /lsevin-media{uri}
		reverse_proxy minio:9000 {
			# Fall back to the .NET static handler when the object is not in the bucket.
			# Without this there is a hole between Caddy reading from MinIO and the API
			# still writing to disk: anything uploaded in between would 404 even though
			# the file exists. It also covers the delta between the mirror and cutover.
			#
			# Deliberately 404 only, never 403. MinIO answers 403 for any prefix the
			# anonymous policy does not cover — CustomerDocument/* above all — and falling
			# back there would hand those files straight to the unauthenticated .NET static
			# handler, undoing the one access-control gain of this change.
			@absent status 404
			handle_response @absent {
				# A single directive rather than strip_prefix plus rewrite: Caddy applies its
				# own directive order inside handle_response, where rewrite runs first and
				# yields /files/lsevin-media/... instead of /files/...
				uri replace /lsevin-media /files 1
				reverse_proxy lsevin-api:8080
			}
		}
	}

	handle {
		reverse_proxy lsevin-api:8080 {
			lb_try_duration 5s
			fail_duration 30s
		}
	}
}

# CRM, Providers, and Shop each run two replicas.
{$CRM_DOMAIN:crm.lsevin.com} {
    import common_headers

    reverse_proxy lsevin-crm-1:3000 lsevin-crm-2:3000 {
        # Share requests across both healthy replicas.
        lb_policy round_robin

        # Test each replica directly every five seconds.
        health_uri /api/health
        health_interval 5s
        health_timeout 3s

        # Stop using a replica quickly after connection failures.
        fail_duration 10s
        max_fails 1

        # Retry another healthy replica before returning an error to the visitor.
        lb_try_duration 5s
    }
}

{$PROVIDERS_DOMAIN:providers.lsevin.com} {
    import common_headers

    reverse_proxy lsevin-providers-1:3000 lsevin-providers-2:3000 {
        lb_policy round_robin
        health_uri /api/health
        health_interval 5s
        health_timeout 3s
        fail_duration 10s
        max_fails 1
        lb_try_duration 5s
    }
}

{$SHOP_DOMAIN:shop.lsevin.com} {
    import common_headers

    reverse_proxy lsevin-shop-1:3000 lsevin-shop-2:3000 {
        lb_policy round_robin
        health_uri /api/health
        health_interval 5s
        health_timeout 3s
        fail_duration 10s
        max_fails 1
        lb_try_duration 5s
    }
}

# Jenkins administration website.
#
# Caddy automatically forwards:
# - Host
# - X-Forwarded-Host
# - X-Forwarded-Proto
# - X-Forwarded-For
#
# Therefore, manually adding these headers is unnecessary.
# The accounting panel. Same webapp process as appmain, but a separate product: the
# middleware serves only /financial on this host and 404s that path on every other one,
# and the panel authenticates against accounting.panel_users rather than the platform's
# admin session. An admin cookie is worth nothing here, and a panel cookie is worth
# nothing on appmain.
{$FINANCIAL_DOMAIN:financial.lsevin.com} {
    import common_headers

    # The books are not for search engines, and must never be framed.
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    reverse_proxy lsevin-webapp:3000
}

{$JENKINS_DOMAIN:devops.lsevin.com} {
	import common_headers

	reverse_proxy lsevin-jenkins:8080
}
