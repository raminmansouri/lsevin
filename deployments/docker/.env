# ── Object storage for uploaded media ──────────────────────────────────────
# MinIO is the storage backend. The bucket already holds the migrated media
# (mirrored 2026-08-20). The Jenkins pipeline runs `minio-init` before each API
# deploy to (idempotently) ensure the bucket, the anonymous-read policy on
# Categories/* + ServiceProviders/*, and the scoped API service account exist.
#
# The API refuses to start if this is not Minio, or if MINIO_API_* are blank or
# the bucket is unreachable (MinioStartupCheck).
FILE_STORAGE_BACKEND=Minio
MINIO_BUCKET=lsevin-media

# Root / console account. Currently the MinIO image defaults — the running
# container was created without MINIO_ROOT_* set. minio-init authenticates with
# these to provision the bucket/policy/service-account.
# SECURITY TODO: rotate these to strong values, then redeploy (minio-init
# re-syncs the service account under the new root on the next run).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Scoped service account the API authenticates with (Get/Put/Delete/List on the
# media bucket only). minio-init creates/refreshes it from these values.
MINIO_API_ACCESS_KEY=N6FWSDSIN4NJMZNWME4D
MINIO_API_SECRET_KEY=xGs4pbKw2wYNUYx9DSWIv2B63M3rWqHS4vp4KStK

LSEVIN_MINIO_DIR=/var/lib/lsevin/minio

# MinIO Console (web UI), published on 127.0.0.1 only. Reach it with an SSH tunnel:
#   ssh -L 9001:localhost:9001 <server>   then open http://localhost:9001
# Sign in with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
MINIO_CONSOLE_HOST_PORT=9001

PROVIDER_PORTAL_ORIGIN=https://providers.lsevin.com
