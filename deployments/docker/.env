# MeliPayamak (Iran OTP SMS). Was previously hardcoded in appsettings.json;
# that value was removed from the app config without these being added here,
# which is what caused the Int64 BodyId binding failure.
MELIPAYAMAK_USERNAME=9128060438
MELIPAYAMAK_PASSWORD=GT4MN
MELIPAYAMAK_BODY_ID=392271

# Object storage for uploaded media. Full procedure:
#   deployments/docker/MEDIA_STORAGE_MIGRATION.md
#
# Kept at FileSystem until the one-time migration has run and verified. Do NOT
# flip this to Minio by hand — the runbook flips it only after
# mirror-uploads-to-minio.sh reports every existing file present in the bucket.
# In Production the API refuses to start on FileSystem (writes would land in the
# container layer and vanish on rebuild) AND refuses to start on Minio while
# MINIO_API_* are still the CHANGE_ME placeholders or the bucket is unreachable.
FILE_STORAGE_BACKEND=FileSystem

# Root / console account. The API never uses this; the minio-init service uses it
# to create the bucket, the anonymous read policy and the scoped API account.
# Confirmed 2026-08-26 via `docker inspect docker-minio-1` — real running values.
MINIO_ROOT_USER=lsevin-minio-admin
MINIO_ROOT_PASSWORD=MHt1OI3MKcmAvzXVF8uvFSTHR9RNrKNCLwcEphoC
MINIO_BUCKET=lsevin-media

# Scoped service account the API authenticates with (Get/Put/Delete/List on the
# media bucket only). Pick a random key/secret here; `docker compose up -d
# minio minio-init` then creates the account from these values. Replace both
# CHANGE_ME lines before the cutover step — minio-init and the API both reject them.
MINIO_API_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_API_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

LSEVIN_UPLOADS_DIR=/var/lib/lsevin/uploads
LSEVIN_MINIO_DIR=/var/lib/lsevin/minio

# MinIO Console (web UI), published on 127.0.0.1 only. Reach it with an SSH tunnel:
#   ssh -L 9001:localhost:9001 <server>   then open http://localhost:9001
# Sign in with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
MINIO_CONSOLE_HOST_PORT=9001

# --- Providers Portal SSO (live path: src/lib/auth/provider-portal-sso.ts and
# src/app/api/provider-portal-sso/{route.ts,verify/route.ts}) --------------
# Dedicated signing secret for the appmain <-> Providers Portal bridge token.
# Without this, the code falls back to reusing AUTH_SECRET (still correct, but
# means rotating AUTH_SECRET would silently also break provider SSO). Must be
# a random string at least 32 characters long, and does NOT need to match
# anything in the Providers Portal's own deployment — the portal only ever
# calls back into appmain's /api/provider-portal-sso/verify to check it.
LSEVIN_SSO_SECRET=3Ymral6X8rbKUb11OV_M7lHOmmunnw1FEVxWWVoeCJU7WYLkcM9xTrcblWwYS7PH
# The debug diagnostic page (isProviderPortalSsoDebugEnabled) defaults to ON
# when this is unset. Explicitly off in production so SSO failures return a
# plain JSON/redirect instead of an HTML page with stage/error-code details.
LSEVIN_SSO_DEBUG=false
# Explicit rather than relying on the code's hardcoded default of the same value.
LSEVIN_PROVIDER_PORTAL_URL=https://providers.lsevin.com

# --- Legacy/unused: PROVIDER_PORTAL_ORIGIN and PROVIDER_PORTAL_SSO_SECRET are
# validated by src/config/env/server.ts and read by src/features/provider-sso/
# server/util.ts, which backs the OLDER /api/provider-sso/authorize route. That
# route has no counterpart in the Providers Portal (which only calls
# /api/lsevin-sso/callback) and is not part of the live SSO flow above. Kept
# here only because they're still declared in the env schema; safe to remove
# once that dead code path is deleted from the app.
PROVIDER_PORTAL_ORIGIN=https://providers.lsevin.com
PROVIDER_PORTAL_SSO_SECRET=YSkUTNRC5IvEv4d7pw1vax8E/Kk/Sd2Q/XsSfnpgJF1eo03i6z0NuBLHiqvTvl4O
NEXT_PUBLIC_LSEVIN_COOKIE_DOMAIN=.lsevin.com
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=YSkUTNRC5IvEv4d7pw1vax8E/Kk/Sd2Q/XsSfnpgJF1eo03i6z0NuBLHiqvTvl4O
