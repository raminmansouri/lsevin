# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=lsevin
POSTGRES_USER=lsevin
POSTGRES_PASSWORD=P4Hu4zym5rfC35X2fbBO7bBt6vN1uq2j

POSTGRES_MONITOR_USER=lsevin
POSTGRES_MONITOR_PASSWORD=P4Hu4zym5rfC35X2fbBO7bBt6vN1uq2j

POSTGRES_IMAGE_TAG=17.10-alpine
POSTGRES_SHM_SIZE=512m

# Different host ports are safer if PostgreSQL already exists locally
POSTGRES_HOST_PORT=55432
PGBOUNCER_HOST_PORT=56432

# Next.js -> PgBouncer inside Docker network
DATABASE_URL=postgres://lsevin:P4Hu4zym5rfC35X2fbBO7bBt6vN1uq2j@pgbouncer:6432/lsevin

# Maintenance/direct connection
DATABASE_URL_DIRECT=postgres://lsevin:P4Hu4zym5rfC35X2fbBO7bBt6vN1uq2j@postgres:5432/lsevin

# ------------------------------------------------------------
# .NET API
# ------------------------------------------------------------

JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=lsevin-api
JWT_SECRET=tpyhBPjVi682ZBFLZmFi6rID1dLXWM9yT3CZt_Xo_5s=

# API is addressed internally by Docker service name
INTERNAL_API_URL=http://lsevin-api:8080/api/v1

# Browser origins allowed by the API
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:3001
CORS_ORIGIN_3=http://127.0.0.1:3000
CORS_ORIGIN_4=http://127.0.0.1:3001

# ------------------------------------------------------------
# PgBouncer
# ------------------------------------------------------------

PGBOUNCER_VERSION=1.25.2

PGBOUNCER_ADMIN_USER=pgbouncer_admin
PGBOUNCER_ADMIN_PASSWORD=e1RmfysHC4ccDGD71vRTdB8FHMsTaWn6

PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_MAX_DB_CONNECTIONS=90
PGBOUNCER_MAX_USER_CONNECTIONS=90
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# ------------------------------------------------------------
# Local bind-mounted configuration
# These directories already correspond to deployments/docker/
# ------------------------------------------------------------

LSEVIN_CONFIG_DIR=./local-config
LSEVIN_BACKUP_DIR=./local-config/backups
LSEVIN_MINIO_DIR=./local-config/minio
LSEVIN_UPLOADS_DIR=./local-config/uploads

# ------------------------------------------------------------
# Provider SSO
# ------------------------------------------------------------

LSEVIN_SSO_SECRET=gHPIxBOECNqjxooRZEO50eyOqfol2a2Dogn3sPpPHDQ=
LSEVIN_SSO_DEBUG=true

# We are not running the providers portal right now
LSEVIN_PROVIDER_PORTAL_URL=http://localhost:3100

# ------------------------------------------------------------
# OTP integrations
# Disable real SMS / WhatsApp locally
# ------------------------------------------------------------

WHATSIPLUS_API_KEY=

MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=
MELIPAYAMAK_BASE_URL=https://rest.payamak-panel.com/api/

HTTP_DEBUG_LOGGING=false
SEQ_URL=

# ------------------------------------------------------------
# Domains
# These matter mainly to Caddy.
# We will NOT start Caddy for the first local run.
# ------------------------------------------------------------

APP_DOMAIN=localhost
API_DOMAIN=localhost
PROVIDERS_DOMAIN=localhost
SHOP_DOMAIN=localhost
CRM_DOMAIN=localhost
JENKINS_DOMAIN=localhost
FINANCIAL_DOMAIN=localhost

CADDY_ACME_EMAIL=local@example.com

# ------------------------------------------------------------
# MinIO
# IMPORTANT:
# docker-compose.server.yml starts the API as Production.
# That API refuses FileSystem storage in Production.
# Therefore MinIO must be enabled even locally when using
# docker-compose.server.yml.
# ------------------------------------------------------------

FILE_STORAGE_BACKEND=Minio

MINIO_BUCKET=lsevin-media

MINIO_ROOT_USER=lsevin-minio-admin
MINIO_ROOT_PASSWORD=ovdmKyIJm_XdZ7dFM9TdFY70cSuO3cu9v0wX-sMonKQ=

MINIO_API_ACCESS_KEY=lsevin-local-api
MINIO_API_SECRET_KEY=q9Pz2x7Lw4mH8sKd3FgR6vTy1Bn5CxUa

MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9002

# ------------------------------------------------------------
# Images / deployment identifiers
# ------------------------------------------------------------

LSEVIN_WEBAPP_IMAGE_TAG=local
LSEVIN_API_IMAGE_TAG=local
LSEVIN_WEBAPP_DEPLOYMENT_ID=local