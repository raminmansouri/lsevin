# ------------------------------------------------------------
# Main web application
# ------------------------------------------------------------

NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_FILES_URL=http://localhost:9000/lsevin-media
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080/hubs

NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_NESHAN_MAP_KEY=

APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

AUTH_SECRET=eeX5ecSEQaUAr4EEfjqVApFE5NloFHLjbim7_ytd1v4=
WEBHOOK_KEY=72c-n15PIA4RqaZGrl3Hxa0tI32laLQuoxqN5GNFmNA=
WEBAPP_API_KEY=29id-tsyognrugYI7jBEsgV4qyCAiAnUcHLTXT2QG34=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=xivtpPt8ZgLg8lhcgpmqF_t0gLz2-0GWCpXH6MvsxxU=

