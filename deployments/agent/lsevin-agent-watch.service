[Unit]
Description=LSevin agent watcher (site A): pull open critical alerts of site A from the hub on B and run the incident agent
After=network-online.target openvpn-client@lsevin-vpn.service

[Service]
Type=oneshot
User=lsevin-agent
ExecStart=/usr/local/sbin/lsevin-agent-watch
TimeoutStartSec=1800
Nice=10
