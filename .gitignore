**/redis-data/
**/eventstore-data/
deployments/docker/backups/

# OS cruft
**/.DS_Store

# Python tooling artifacts
**/__pycache__/
**/*.py[cod]


# Migrations are source code, not database dumps — the blanket *.sql rule above
# would otherwise silently drop the entire accounting schema from every commit.
!frontend/webapp/db/migrations/
!frontend/webapp/db/migrations/*.sql
!frontend/webapp/db/migrations/*.md
!docs/SEO-PERFORMANCE-2026-10-25.md
!frontend/webapp/tests/fixtures/*.sql
**/.pnpm-store/
