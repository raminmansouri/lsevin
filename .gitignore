# Development bootstrap SQL is schema/fixture source, not a production dump.
!auto_backups/schema_backup.sql
!deployments/docker/dev-seed/*.sql
# Dual-site (Iran/global) sync scripts: SQL here is configuration for SymmetricDS, not a data dump.
!deployments/symmetricds/sql/*.sql
!deployments/dr/*.sql

**/*.md
!frontend/webapp/docs/pwa.md
!frontend/webapp/docs/pwa-verification.md
frontend/webapp/pwa-*.log
frontend/webapp/test-results/
