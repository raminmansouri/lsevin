# Long-running web container only. Do not place the privileged migration
# password in this file.
PROVIDER_PORTAL_DB_MODE=split
PGHOST=postgres-or-managed-db-host
PGPORT=5432
PGDATABASE=lsevin
PGUSER=providers_portal_app
PGPASSWORD=CHANGE_ME_RUNTIME_PASSWORD
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT=20
POSTGRES_MAX_LIFETIME=1800
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_PREPARE=true

NEXT_PUBLIC_APP_NAME=LSevin Providers Portal
NEXT_PUBLIC_APP_URL=https://providers.lsevin.com
NEXT_PUBLIC_DEFAULT_LOCALE=fa-IR
NEXT_PUBLIC_DEFAULT_DIRECTION=rtl
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Tehran
NEXT_PUBLIC_LOCALE_COOKIE_DOMAIN=.lsevin.com

PROVIDER_PORTAL_LOCAL_AUTH=false
LSEVIN_SSO_URL=https://appmain.lsevin.com
PROVIDER_PORTAL_SSO_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PROVIDER_PORTAL_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
LSEVIN_SHARED_COOKIE_DOMAIN=.lsevin.com
LSEVIN_USER_ID_COOKIE=lsevin_user_id
LSEVIN_USER_ID_HEADER=x-lsevin-user-id
ALLOW_TRUSTED_USER_HEADER=false
TRUSTED_PROXY_ENFORCED=false

PRIVATE_FILE_STORAGE_ROOT=/var/lib/lsevin/private-files
PROVIDER_MEDIA_STORAGE_ROOT=/app/public
PROVIDER_MEDIA_PUBLIC_BASE_URL=https://providers.lsevin.com
ALLOW_LEGACY_MEDIA_URLS=false
PAYMENT_GATEWAYS_ENABLED=none
