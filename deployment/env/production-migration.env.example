# Used only by the short-lived psql migration container.
# This account needs DDL rights for the Providers Portal schemas.
# Migrations deliberately connect directly to PostgreSQL, bypassing PgBouncer.
# The publisher uses a session advisory lock and transactional DDL, so changing
# this to pgbouncer:6432 would make its safety contract depend on pool mode.
# Both stacks join `lsevin-network`, so Docker DNS resolves `postgres` directly.
PGHOST=postgres
PGPORT=5432
PGDATABASE=lsevin
PGUSER=providers_portal_migrator
PGPASSWORD=wI4Rj9rdGIW8Y2Ha2OAhKetLclIexguu
PGCONNECT_TIMEOUT=10
PGAPPNAME=lsevin-providers-migration
