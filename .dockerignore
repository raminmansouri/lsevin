# Keep the .NET API build context lean
.git
.vs
.vscode
frontend
tests
docs
DataEntry
auto_backups
deployments
**/bin
**/obj
**/node_modules
**/.next
**/UploadFiles
*.sql

# The local PostgreSQL bootstrap image needs exactly these schema/fixture files.
!auto_backups/
auto_backups/*
!auto_backups/schema_backup.sql
!deployments/
deployments/*
!deployments/docker/
deployments/docker/*
!deployments/docker/dev-seed/
deployments/docker/dev-seed/*
!deployments/docker/dev-seed/05_ef_migration_baseline.sql
!deployments/docker/dev-seed/10_dev_seed.sql
**/.DS_Store
**/*.user
